+def _merge_states(*states):
+    merged = []
+    for index in (0, 2, 4):
+        merge = set.union if index == 0 else set.intersection
+        merged.extend((tuple(merge(*(state[index][i] for state in states))
+                             for i in range(len(states[0][index]))),
+                       merge(*(state[index + 1] for state in states))))
+    return tuple(merged)
