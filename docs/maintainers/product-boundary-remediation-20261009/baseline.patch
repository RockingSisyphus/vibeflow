+    def include(self, frames, state, kind="unknown"):
+        projected = []
+        for index in (0, 2, 4):
+            by_owner = {frame[0]: names for frame, names in zip(frames, state[index])}
+            projected.extend((tuple(set(by_owner[owner]) for owner in self.owners), set(state[index + 1])))
+        projected = tuple(projected)
+        previous = self.states.get(kind)
+        self.states[kind] = projected if previous is None else _merge_states(previous, projected)
