+def _source_input_call_targets(sources):
+    """Project canonical call references into borrowed function ASTs."""
+    functions = {item.id:item._node for item in sources.symbols
+                 if isinstance(item._node, (ast.FunctionDef, ast.AsyncFunctionDef))}
+    targets = {}
+    for reference in sources.references:
+        if reference.kind == "call" and reference.target in functions:
+            path = reference.source.rpartition(":")[0]
+            targets.setdefault(path, {})[(reference.line, reference.column)] = functions[reference.target]
+    return targets
+
+
