{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeflow.local/schema/node.schema.json",
  "title": "VibeFlow canonical NodeDescriptor",
  "type": "object",
  "required": [
    "kind",
    "type_key",
    "display_name",
    "description",
    "version",
    "flow_kind",
    "contract"
  ],
  "properties": {
    "kind": {
      "const": "node"
    },
    "type_key": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "flow_kind": {
      "enum": [
        "terminal",
        "process",
        "decision",
        "io",
        "predefined",
        "data_store",
        "document",
        "preparation",
        "global_state"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external": {
      "type": "boolean"
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "implementations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementation"
      }
    },
    "base_libs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rulesets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contract": {
      "type": "object",
      "required": [],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataRequirement"
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataProvider"
          }
        },
        "input_semantics": {
          "type": "object"
        },
        "output_semantics": {
          "type": "object"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "inputs": {
                "type": "object"
              },
              "params": {
                "type": "object"
              },
              "outputs": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "params_schema": {
          "type": "object"
        },
        "params_defaults": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "dataProvider": {
      "type": "object",
      "required": [
        "key",
        "type",
        "display_name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dataRequirement": {
      "type": "object",
      "required": [
        "type",
        "cardinality",
        "display_name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "enum": [
            "exactly_one",
            "optional_one",
            "all"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": [
        "language",
        "targets",
        "source"
      ],
      "properties": {
        "language": {
          "enum": [
            "python",
            "javascript",
            "typescript",
            "js",
            "ts"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "module",
                "file",
                "package",
                "generated"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "export": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "targets": {
          "type": "array",
          "items": {
            "enum": [
              "python",
              "node",
              "browser"
            ]
          },
          "minItems": 1
        },
        "completion": {
          "enum": [
            "immediate",
            "suspend"
          ]
        },
        "implementation_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "file"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "export": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
