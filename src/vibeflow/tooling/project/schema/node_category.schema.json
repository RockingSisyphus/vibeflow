{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeflow.local/schema/node_category.schema.json",
  "title": "VibeFlow NodeCategoryDescriptor",
  "type": "object",
  "required": [
    "kind",
    "id"
  ],
  "properties": {
    "kind": {
      "const": "node_category"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "default_rulesets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentation": {
      "$ref": "node.schema.json#/$defs/presentation"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
