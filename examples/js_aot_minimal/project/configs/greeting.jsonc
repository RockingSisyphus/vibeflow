{
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "name",
        "type": "name.text",
        "display_name": "Name",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "greet",
        "type_used": "example.greet",
        "display_name": "Build greeting",
        "description": "Formats a greeting with an injected clock.",
        "requires": [
          {
            "type": "name.text",
            "cardinality": "exactly_one",
            "display_name": "Name"
          }
        ],
        "provides": [
          {
            "key": "greeting",
            "type": "greeting.text",
            "display_name": "Greeting"
          }
        ],
        "config": {
          "prefix": "Hello"
        }
      }
    ],
    "edges": [],
    "outputs": [
      {
        "type": "greeting.text",
        "cardinality": "exactly_one",
        "display_name": "Greeting",
        "as": "greeting"
      }
    ]
  }
}
