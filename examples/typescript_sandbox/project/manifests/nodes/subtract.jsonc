{
  "kind": "node",
  "type_key": "sandbox.subtract",
  "display_name": "Subtract",
  "category": "sandbox",
  "description": "Subtracts b from an incoming sum through the registered TypeScript base_lib.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.sum",
        "cardinality": "exactly_one",
        "display_name": "Sum"
      },
      {
        "type": "sandbox.subtrahend.forwarded",
        "cardinality": "exactly_one",
        "display_name": "Forwarded subtrahend"
      }
    ],
    "provides": [
      {
        "key": "result",
        "type": "sandbox.math.result",
        "display_name": "Result"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "output_schema": {
      "result": {
        "type": "number"
      }
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "nodes/subtract.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": ["sandbox.math"],
  "capabilities": []
}
