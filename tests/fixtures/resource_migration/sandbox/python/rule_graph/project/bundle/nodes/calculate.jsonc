{
  "kind": "node",
  "type_key": "example.calculate",
  "display_name": "Calculate",
  "description": "An executable Node in the typed Rule graph example.",
  "version": "0.15.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "example.input",
        "cardinality": "exactly_one",
        "display_name": "Input"
      }
    ],
    "provides": [
      {
        "key": "result",
        "type": "example.output",
        "display_name": "Result"
      }
    ],
    "input_semantics": {
      "example.input": [
        "The number to calculate."
      ]
    },
    "output_semantics": {
      "result": [
        "Twice the number plus one."
      ]
    }
  },
  "rulesets": [
    "example.rule_graph"
  ],
  "implementations": [
