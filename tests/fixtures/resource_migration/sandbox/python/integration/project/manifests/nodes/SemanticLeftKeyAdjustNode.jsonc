{
  "kind": "node",
  "type_key": "semantic.left_key_adjust",
  "display_name": "Semantic Left Key Adjust",
  "description": "Adds a configured bonus and exposes the result with the calc.left_branch data type.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "semantic"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "calc.scaled",
        "cardinality": "exactly_one",
        "display_name": "calc.scaled"
      }
    ],
    "provides": [
      {
        "key": "calc.left_branch",
        "type": "calc.left_branch",
        "display_name": "calc.left_branch"
      }
    ],
    "input_semantics": {
      "calc.scaled": [
        "scaled arithmetic value selected for the left branch"
      ]
    },
    "output_semantics": {
      "calc.left_branch": [
        "left branch value after adding bonus"
      ]
    },
    "examples": [],
    "params_schema": {
      "bonus": {
        "type": "number"
      }
    },
    "params_defaults": {
      "bonus": 0
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticLeftKeyAdjustNode"
      }
    }
  ]
}
