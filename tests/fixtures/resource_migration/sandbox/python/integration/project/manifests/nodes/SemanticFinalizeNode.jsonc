{
  "kind": "node",
  "type_key": "semantic.finalize",
  "display_name": "Semantic Finalize",
  "description": "Adds a configured offset to calc.branch into calc.final.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "semantic"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "calc.branch",
        "cardinality": "exactly_one",
        "display_name": "calc.branch"
      }
    ],
    "provides": [
      {
        "key": "calc.final",
        "type": "calc.final",
        "display_name": "calc.final"
      }
    ],
    "input_semantics": {
      "calc.branch": [
        "branch or promoted scaled value to finalize"
      ]
    },
    "output_semantics": {
      "calc.final": [
        "calc.branch plus offset"
      ]
    },
    "examples": [
      {
        "inputs": {
          "calc.branch": {
            "key": "calc.branch",
            "type": "calc.branch",
            "value": 31,
            "source_node": "example"
          }
        },
        "params": {
          "offset": 1
        }
      }
    ],
    "params_schema": {
      "offset": {
        "type": "number"
      }
    },
    "params_defaults": {
      "offset": 0
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticFinalizeNode"
      }
    }
  ]
}
