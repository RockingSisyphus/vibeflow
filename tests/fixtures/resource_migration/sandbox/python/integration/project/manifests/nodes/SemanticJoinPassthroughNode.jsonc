{
  "kind": "node",
  "type_key": "semantic.join_passthrough",
  "display_name": "Semantic Join Passthrough",
  "description": "Consumes one value.in envelope and emits value.out without changing the selected branch value.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "semantic"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.in",
        "cardinality": "exactly_one",
        "display_name": "value.in"
      }
    ],
    "provides": [
      {
        "key": "value.out",
        "type": "value.out",
        "display_name": "value.out"
      }
    ],
    "input_semantics": {
      "value.in": [
        "value selected by a safe join"
      ]
    },
    "output_semantics": {
      "value.out": [
        "selected value after the join"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.in": {
            "key": "value.left",
            "type": "value.in",
            "value": 3,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticJoinPassthroughNode"
      }
    }
  ]
}
