{
  "kind": "node",
  "type_key": "sandbox.report_output",
  "display_name": "报告输出接口",
  "description": "把报告文档转换为程序对外输出；该节点验证 I/O 不是开始或结束，而是流程中的输入输出动作。",
  "version": "0.1.0",
  "flow_kind": "io",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "document.report",
        "cardinality": "exactly_one",
        "display_name": "document.report"
      }
    ],
    "provides": [
      {
        "key": "io.output",
        "type": "io.output",
        "display_name": "io.output"
      }
    ],
    "input_semantics": {
      "document.report": [
        "已经生成的报告文档正文。"
      ]
    },
    "output_semantics": {
      "io.output": [
        "程序最终对外暴露的输出载荷。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "document.report": {
            "key": "document.report",
            "type": "document.report",
            "value": "final=13;request=13",
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.io"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_comprehensive_nodes.py",
        "export": "ReportOutputNode"
      }
    }
  ]
}
