{
  "kind": "node",
  "type_key": "sandbox.configure_runtime_mode",
  "display_name": "配置进程运行模式",
  "description": "修改一个仅存在于当前 execution domain 的模块运行标记；示例不依赖任何第三方工具，用来展示受审计的 global_state 节点。是否互斥只由显式命名 execution lock 决定。",
  "version": "0.1.0",
  "flow_kind": "global_state",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.in",
        "cardinality": "exactly_one",
        "display_name": "value.in"
      }
    ],
    "provides": [
      {
        "key": "value.in.runtime",
        "type": "value.in",
        "display_name": "value.in.runtime"
      }
    ],
    "input_semantics": {
      "value.in": [
        "沿 envelope 流转的普通业务值；它不是 ambient state。"
      ]
    },
    "output_semantics": {
      "value.in.runtime": [
        "原样传给下一节点的业务值。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.in": {
            "key": "value.in",
            "type": "value.in",
            "value": 3,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.global_state"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_comprehensive_nodes.py",
        "export": "ConfigureRuntimeModeNode"
      }
    }
  ]
}
