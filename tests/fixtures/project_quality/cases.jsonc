{
  "node_cases": [
    {
      "name": "giant_node",
      "kind": "generated_giant_node",
      "expected_code": "NODE.PURITY.SOURCE_TOO_LARGE"
    },
    {
      "name": "hidden_side_effect",
      "run_body": "        open(\"x.txt\", \"w\")\n        return {\"demo.out\": 1}",
      "expected_code": "NODE.EFFECT.CALL_FORBIDDEN"
    },
    {
      "name": "dynamic_import",
      "run_body": "        importlib.import_module(\"math\")\n        return {\"demo.out\": 1}",
      "expected_allowed": true,
      "retired_code": "NODE.PURITY.BANNED_CALL",
      "migration": "B06: string evaluation and dynamic import are not default security policy."
    },
    {
      "name": "node_mutual_call",
      "kind": "node_mutual_call",
      "expected_code": "NODE.METADATA.NODE_DIRECT_CALL"
    },
    {
      "name": "module_top_level_side_effect",
      "kind": "module_top_level_side_effect",
      "expected_code": "NODE.IMPORT.SIDE_EFFECT"
    }
  ],
  "config_cases": [
    {
      "name": "removed_loop_registration",
      "expected_rule_id": "CONFIG.LOOPS.REMOVED",
      "config": {
        "pipeline": {
          "nodes": [
            {
              "display_name": "Add",
              "description": "Adds value.in.",
              "id": "add",
              "definition_id": "test.add"
            },
            {
              "display_name": "Copy",
              "description": "Copies value.out back to value.in.",
              "id": "copy",
              "definition_id": "test.copy"
            }
          ],
          "loops": [
            {
              "name": "old",
              "edges": [
                [
                  "copy",
                  "add"
                ]
              ],
              "max_iterations": 2
            }
          ]
        }
      }
    },
    {
      "name": "illegal_boundary",
      "expected_rule_id": "CONFIG.BOUNDARY.REMOVED",
      "config": {
        "boundary": {
          "type": "bad.boundary",
          "consumes": [
            "value.out"
          ],
          "provides": [
            "bad.result"
          ]
        },
        "pipeline": {
          "nodes": [
            {
              "display_name": "Seed",
              "description": "Produces value.in.",
              "id": "seed",
              "definition_id": "test.seed"
            }
          ]
        }
      }
    }
  ],
  "base_lib_cases": [
    {
      "name": "base_lib_escape",
      "module_source": "from nodes.some_node import SomeNode\n\n\ndef helper():\n    return 1\n",
      "expected_rule_id": "VF_IMPORT_LAYER"
    }
  ],
  "health_cases": [
    {
      "name": "decision_cycle_forbidden",
      "expected_rule_id": "GRAPH.CYCLE.FORBIDDEN",
      "config": {
        "pipeline": {
          "inputs": [
            {
              "key": "value.in",
              "type": "value.in",
              "display_name": "Value In",
              "required": true
            }
          ],
          "nodes": [
            {
              "display_name": "Add",
              "description": "Adds value.in.",
              "id": "add",
              "definition_id": "test.add"
            },
            {
              "display_name": "Route",
              "description": "Routes the loop.",
              "id": "route",
              "definition_id": "test.route"
            },
            {
              "display_name": "Copy",
              "description": "Copies output back to the loop input.",
              "id": "copy",
              "definition_id": "test.copy_alt"
            },
            {
              "display_name": "End",
              "description": "Consumes value.in.",
              "id": "end",
              "definition_id": "test.in_end"
            }
          ],
          "edges": [
            {
              "from": "add",
              "to": "route"
            },
            {
              "from": "route",
              "to": "copy",
              "when": "flow.route == 'again'"
            },
            {
              "from": "copy",
              "to": "add"
            }
          ]
        }
      }
    },
    {
      "name": "duplicate_explicit_edge",
      "expected_rule_id": "GRAPH.EDGE.DUPLICATE",
      "config": {
        "pipeline": {
          "nodes": [
            {
              "display_name": "Start",
              "description": "Starts the duplicate edge fixture.",
              "id": "start",
              "definition_id": "test.start"
            },
            {
              "display_name": "Seed",
              "description": "Produces value.in.",
              "id": "seed",
              "definition_id": "test.seed"
            },
            {
              "display_name": "End",
              "description": "Consumes value.in.",
              "id": "end",
              "definition_id": "test.in_end"
            }
          ],
          "edges": [
            {
              "from": "start",
              "to": "seed"
            },
            {
              "from": "start",
              "to": "seed"
            },
            {
              "from": "seed",
              "to": "end"
            }
          ]
        }
      }
    },
    {
      "name": "alternative_conditions_same_endpoints",
      "expected_absent_rule_id": "GRAPH.EDGE.CONFLICTING_DUPLICATE",
      "config": {
        "pipeline": {
          "nodes": [
            {
              "display_name": "Route",
              "description": "Produces route values.",
              "id": "route",
              "definition_id": "test.route"
            },
            {
              "display_name": "Copy",
              "description": "Copies value.in to value.out.",
              "id": "copy",
              "definition_id": "test.copy"
            }
          ],
          "edges": [
            {
              "from": "route",
              "to": "copy",
              "when": "flow.route == 'again'"
            },
            {
              "from": "route",
              "to": "copy",
              "when": "flow.route == 'done'"
            }
          ]
        }
      }
    }
  ],
  "rule_cases": [
    {
      "name": "ruleset_can_leave_workflow_unconstrained",
      "absent_code": "GRAPH.SMELL.CONFUSING_NODE_NAME",
      "config": {
        "rulesets": [],
        "pipeline": {
          "nodes": [
            {
              "display_name": "Start",
              "description": "Starts the policy fixture.",
              "id": "start",
              "definition_id": "test.start"
            },
            {
              "display_name": "Bad Name",
              "description": "Produces value.in for the policy fixture.",
              "id": "BadName",
              "definition_id": "test.seed"
            },
            {
              "display_name": "End",
              "description": "Consumes value.in.",
              "id": "end",
              "definition_id": "test.in_end"
            }
          ],
          "edges": [
            {
              "from": "start",
              "to": "BadName"
            },
            {
              "from": "BadName",
              "to": "end"
            }
          ]
        }
      }
    }
  ],
  "quality_cases": [
    {
      "name": "too_many_function_params",
      "expected_rule_id": "QUALITY.FUNCTION.TOO_MANY_PARAMS",
      "root_rules": {
        "rulesets": [
          {
            "rule_id": "vibeflow.root.files",
            "params": {
              "max_function_params": 2
            }
          }
        ]
      },
      "files": {
        "wide.py": "def too_wide(a,b,c):\n    return a+b+c\n"
      }
    }
  ],
  "architecture_cases": [
    {
      "name": "optional_architecture_report_not_health_gate",
      "config": {
        "pipeline": {
          "nodes": [
            {
              "display_name": "Start",
              "description": "Starts the architecture fixture.",
              "id": "start",
              "definition_id": "test.start"
            },
            {
              "display_name": "Seed",
              "description": "Produces value.in.",
              "id": "seed",
              "definition_id": "test.seed"
            },
            {
              "display_name": "Add",
              "description": "Adds value.in.",
              "id": "add",
              "definition_id": "test.add"
            },
            {
              "display_name": "End",
              "description": "Consumes value.out.",
              "id": "end",
              "definition_id": "test.out_end"
            }
          ],
          "edges": [
            {
              "from": "start",
              "to": "seed"
            },
            {
              "from": "seed",
              "to": "add"
            },
            {
              "from": "add",
              "to": "end"
            }
          ]
        }
      }
    }
  ]
}
