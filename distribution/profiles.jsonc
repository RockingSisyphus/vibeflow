      "distribution/docs/user/profiles/collaborative.md"
    ],
    "autonomous": [
      "distribution/docs/user/profiles/autonomous.md"
    ]
  },
  "profiles": {
    "collaborative": {
      "prompt_fragments": [
        "distribution/prompts/common.md",
        "distribution/prompts/collaborative.md"
      ],
      "document_sets": [
        "common",
        "collaborative"
      ],
      "agent_protocol": {
        "change_inventory": "required",
        "planned_review": true,
        "human_approval_gate": true,
        "required_review_artifact": "html_preview"
      },
      "agent_automation": {
        "refresh_architecture": true,
        "validate": true,
        "quality": true,
        "build": true,
        "workflow_execution_probe": true
      }
    },
    "autonomous": {
      "prompt_fragments": [
        "distribution/prompts/common.md",
        "distribution/prompts/autonomous.md"
      ],
      "document_sets": [
        "common",
        "autonomous"
      ],
      "agent_protocol": {
        "change_inventory": "optional",
        "planned_review": false,
        "human_approval_gate": false,
        "required_review_artifact": "on_demand"
      },
      "agent_automation": {
        "refresh_architecture": true,
        "validate": true,
        "quality": true,
        "build": true,
        "workflow_execution_probe": true
      }
    }
  }
}
