{
  "schema": "vibeflow.distribution-profiles.v1",
  "document_sets": {
    "common": [
      "distribution/docs/overview.md",
      "distribution/docs/user/quickstart.md",
      "distribution/docs/user/workflow-and-config.md",
      "distribution/docs/user/project-governance.md",
      "distribution/docs/user/workflow-coordination.md",
      "distribution/docs/user/python-development.md",
      "distribution/docs/user/javascript-development.md",
      "distribution/docs/user/nodeset-types-and-loops.md",
      "distribution/docs/user/plugins-and-integrations.md",
      "distribution/docs/user/multifile-resources.md",
      "distribution/docs/user/rules-and-nodes.md",
      "distribution/docs/user/rule-system-migration.md",
      "distribution/docs/user/runtime-observation.md",
      "distribution/docs/user/local-preview.md",
      "distribution/docs/user/graph-concurrency.md",
      "distribution/docs/user/commands-and-results.md",
