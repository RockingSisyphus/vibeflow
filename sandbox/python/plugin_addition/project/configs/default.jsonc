{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/addition/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "nodeset_imports": [
    {
      "path": "nodeset_types/step.jsonc"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "a",
        "type": "addition.a",
        "display_name": "addition.a",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "addition.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "step",
        "definition_id": "addition.step",
        "display_name": "step",
        "description": "step"
      },
      {
        "id": "end",
        "definition_id": "addition.boundary",
        "display_name": "end",
        "description": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "step"
      },
      {
        "from": "step",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "addition.result",
        "cardinality": "exactly_one",
        "display_name": "addition.result",
        "as": "result"
      }
    ]
  }
}
