{
  "type_key": "fixture.worker_block",
  "display_name": "Nested worker",
  "description": "Reuse the worker contract within an explicitly owned task target",
  "requires": [
    {
      "type": "fixture.request",
      "cardinality": "exactly_one",
      "display_name": "Request"
    }
  ],
  "provides": [
    {
      "key": "fixture.value",
      "type": "fixture.value",
      "display_name": "Value"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "request",
        "type": "fixture.request",
        "required": true,
        "display_name": "Request"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "fixture.terminal",
        "display_name": "Start",
        "description": "Enter owned worker block"
      },
      {
        "id": "work",
        "type_used": "fixture.worker",
        "display_name": "Worker",
        "description": "Own one worker invocation"
      },
      {
        "id": "end",
        "type_used": "fixture.terminal",
        "display_name": "End",
        "description": "Exit after worker finally"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "work"
      },
      {
        "from": "work",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "fixture.value",
        "cardinality": "exactly_one",
        "as": "fixture.value",
        "display_name": "Value"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.py",
        "export": "plugin"
      }
    }
  ]
}
