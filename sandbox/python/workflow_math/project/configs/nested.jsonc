{
  "pipeline": {
    "inputs": [
      {
        "key": "calc.a",
        "type": "calc.a",
        "display_name": "Calc A",
        "required": true
      },
      {
        "key": "calc.b",
        "type": "calc.b",
        "display_name": "Calc B",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "arithmetic",
        "definition_id": "semantic.arithmetic",
        "display_name": "Arithmetic",
        "description": "Runs arithmetic."
      },
      {
        "id": "use_scaled",
        "definition_id": "semantic.use_scaled",
        "display_name": "Use Scaled",
        "description": "Runs use_scaled."
      },
      {
        "offset": 5,
        "id": "finalize",
        "definition_id": "semantic.finalize",
        "display_name": "Finalize",
        "description": "Runs finalize."
      },
      {
        "id": "end",
        "definition_id": "semantic.final_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "arithmetic"
      },
      {
        "from": "arithmetic",
        "to": "use_scaled"
      },
      {
        "from": "use_scaled",
        "to": "finalize"
      },
      {
        "from": "finalize",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "calc.final",
        "cardinality": "exactly_one",
        "display_name": "Calc Final"
      },
      {
        "type": "calc.branch",
        "cardinality": "optional_one",
        "display_name": "Calc Branch"
      },
      {
        "type": "calc.scaled",
        "cardinality": "optional_one",
        "display_name": "Calc Scaled"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodeset_types/pass_semantic_nodeset_arithmetic/semantic_arithmetic.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
