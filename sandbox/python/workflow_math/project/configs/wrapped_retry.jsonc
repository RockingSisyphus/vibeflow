{
  "pipeline": {
    "inputs": [
      {
        "key": "loop.current",
        "type": "loop.current",
        "display_name": "Loop Current",
        "required": true
      }
    ],
    "nodes": [
      {
        "display_name": "Start",
        "description": "Starts the nested loop nodeset fixture.",
        "id": "start",
        "definition_id": "sandbox.start"
      },
      {
        "display_name": "Wrapper",
        "description": "Calls a nodeset that contains a first-class while loop node.",
        "id": "wrapper",
        "definition_id": "loop.wrapper"
      },
      {
        "display_name": "End",
        "description": "Ends after the wrapper nodeset produces loop outputs.",
        "id": "end",
        "definition_id": "sandbox.start"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "wrapper"
      },
      {
        "from": "wrapper",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "loop.next",
        "cardinality": "exactly_one",
        "display_name": "Loop Next"
      },
      {
        "type": "loop.done",
        "cardinality": "exactly_one",
        "display_name": "Loop Done"
      },
      {
        "type": "loop.iterations",
        "cardinality": "exactly_one",
        "display_name": "Loop Iterations"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodeset_types/pass_loop_while_inside_nodeset/loop_retry_step.jsonc"
    },
    {
      "path": "nodeset_types/pass_loop_while_inside_nodeset/loop_wrapper.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "workflow.add"
    ]
  }
}
