{
  "display_name": "Retry Step",
  "description": "Increments loop.current and reports whether the retry loop should stop.",
  "requires": [
    {
      "type": "loop.current",
      "cardinality": "exactly_one",
      "display_name": "Loop Current"
    }
  ],
  "provides": [
    {
      "key": "loop.next",
      "type": "loop.next",
      "display_name": "Loop Next"
    },
    {
      "key": "loop.done",
      "type": "loop.done",
      "display_name": "Loop Done"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "loop.current",
        "type": "loop.current",
        "display_name": "Loop Current",
        "required": true
      }
    ],
    "nodes": [
      {
        "display_name": "Body Start",
        "description": "Starts one while-loop retry body invocation.",
        "id": "start",
        "definition_id": "sandbox.start"
      },
      {
        "display_name": "Increment",
        "description": "Moves the retry value toward the target.",
        "step": 2,
        "id": "increment",
        "definition_id": "semantic.increment_until"
      },
      {
        "display_name": "Done Check",
        "description": "Checks whether loop.next has reached the retry target.",
        "target": 7,
        "id": "done",
        "definition_id": "semantic.loop_done_value"
      },
      {
        "display_name": "Body End",
        "description": "Ends a body iteration after loop.next and loop.done are available.",
        "id": "end",
        "definition_id": "sandbox.start"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "increment"
      },
      {
        "from": "increment",
        "to": "done"
      },
      {
        "from": "done",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "loop.next",
        "cardinality": "exactly_one",
        "display_name": "Loop Next"
      },
      {
        "type": "loop.done",
        "cardinality": "exactly_one",
        "display_name": "Loop Done"
      }
    ]
  },
  "type_key": "loop.retry_step",
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
