{
  "kind": "ruleset",
  "id": "example.data_domain",
  "calls": [
    {
      "id": "native",
      "ruleset_id": "vibeflow.process"
    },
    {
      "id": "definition",
      "rule_id": "example.model_definition"
    }
  ],
  "entrypoints": {
    "import": [
      "native"
    ],
    "static": [
      "native",
      "definition"
    ],
    "run": [
      "native",
      "definition"
    ]
  }
}
