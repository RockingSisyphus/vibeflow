{
  "kind": "rule",
  "id": "example.model_definition",
  "description": "One direct model_forward method per model_block; helpers do not inherit legal model-definition ownership.",
  "scope": "source",
  "params_schema": {
    "model_category": {
      "type": "string"
    },
    "marker_method": {
      "type": "string"
    }
  },
  "params_defaults": {
    "model_category": "model_block",
    "marker_method": "model_forward"
  },
  "outputs": {
    "evidence": "example.model_definition.v1"
  },
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "rules/model_definition.py",
        "export": "check"
      }
    }
  ]
}
