{
  "kind": "node",
  "type_key": "example.transform",
  "display_name": "DataTransform",
  "category": "data_transform",
  "description": "One data_transform block in the example workflow.",
  "version": "0.15.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "example.feature",
        "cardinality": "exactly_one",
        "display_name": "Feature"
      }
    ],
    "provides": [
      {
        "key": "result",
        "type": "example.output",
        "display_name": "Result"
      }
    ],
    "input_semantics": {
      "example.feature": [
        "Model result to transform."
      ]
    },
    "output_semantics": {
      "result": [
        "Model result plus an offset."
      ]
    },
    "params_schema": {
      "offset": {
        "type": "number"
      }
    },
    "params_defaults": {
      "offset": 1
    },
    "examples": [
      {
        "inputs": {
          "example.feature": {
            "value": 6
          }
        },
        "params": {
          "offset": 1
        }
      }
    ]
  },
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "domain_nodes.py",
        "export": "DataTransform"
      }
    }
  ]
}
