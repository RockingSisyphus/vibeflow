{
  "kind": "node",
  "type_key": "semantic.two_input_join",
  "display_name": "Semantic Two Input Join",
  "description": "Consumes value.in and other.in after an explicit all join.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "semantic"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.in",
        "cardinality": "exactly_one",
        "display_name": "value.in"
      },
      {
        "type": "other.in",
        "cardinality": "exactly_one",
        "display_name": "other.in"
      }
    ],
    "provides": [
      {
        "key": "value.out",
        "type": "value.out",
        "display_name": "value.out"
      }
    ],
    "input_semantics": {
      "value.in": [
        "primary join input"
      ],
      "other.in": [
        "secondary join input"
      ]
    },
    "output_semantics": {
      "value.out": [
        "sum of both join inputs"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.in": {
            "key": "value.left",
            "type": "value.in",
            "value": 3,
            "source_node": "example"
          },
          "other.in": {
            "key": "other.in",
            "type": "other.in",
            "value": 5,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticTwoInputJoinNode"
      }
    }
  ]
}
