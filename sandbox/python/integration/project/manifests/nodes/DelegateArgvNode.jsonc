{
  "kind": "node",
  "type_key": "sandbox.delegate_argv",
  "display_name": "解析受让的 CLI 参数",
  "category": "sandbox",
  "description": "使用普通 argparse 解析 VibeFlow 原样注入的 cli.argv。",
  "version": "0.1.0",
  "flow_kind": "io",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "cli.argv",
        "cardinality": "exactly_one",
        "display_name": "cli.argv"
      }
    ],
    "provides": [
      {
        "key": "cli.input_path",
        "type": "cli.input_path",
        "display_name": "cli.input_path"
      },
      {
        "key": "cli.verbose",
        "type": "cli.verbose",
        "display_name": "cli.verbose"
      }
    ],
    "input_semantics": {
      "cli.argv": [
        "不含 argv0 和 -- 分隔符的业务命令行参数。"
      ]
    },
    "output_semantics": {
      "cli.input_path": [
        "业务 --input 参数指定的文件路径。"
      ],
      "cli.verbose": [
        "是否启用详细业务输出。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "cli.argv": {
            "key": "cli.argv",
            "type": "cli.argv",
            "value": [
              "--input",
              "data.yaml",
              "--verbose"
            ],
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.io"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_delegate_cli_nodes.py",
        "export": "DelegateArgvNode"
      }
    }
  ]
}
