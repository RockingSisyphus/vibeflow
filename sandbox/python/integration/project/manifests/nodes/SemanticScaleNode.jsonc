{
  "kind": "node",
  "type_key": "semantic.scale",
  "display_name": "Semantic Scale",
  "category": "semantic",
  "description": "Multiplies calc.sum by a configured factor into calc.scaled.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "calc.sum",
        "cardinality": "exactly_one",
        "display_name": "calc.sum"
      }
    ],
    "provides": [
      {
        "key": "calc.scaled",
        "type": "calc.scaled",
        "display_name": "calc.scaled"
      }
    ],
    "input_semantics": {
      "calc.sum": [
        "numeric sum to multiply"
      ]
    },
    "output_semantics": {
      "calc.scaled": [
        "calc.sum multiplied by factor"
      ]
    },
    "examples": [
      {
        "inputs": {
          "calc.sum": {
            "key": "calc.sum",
            "type": "calc.sum",
            "value": 7,
            "source_node": "example"
          }
        },
        "params": {
          "factor": 3
        }
      }
    ],
    "params_schema": {
      "factor": {
        "type": "number"
      }
    },
    "params_defaults": {
      "factor": 1
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticScaleNode"
      }
    }
  ]
}
