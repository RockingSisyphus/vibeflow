{
  "kind": "node",
  "type_key": "semantic.right_key_adjust",
  "display_name": "Semantic Right Key Adjust",
  "category": "semantic",
  "description": "Subtracts a configured penalty and exposes the result with the calc.right_branch data type.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "calc.scaled",
        "cardinality": "exactly_one",
        "display_name": "calc.scaled"
      }
    ],
    "provides": [
      {
        "key": "calc.right_branch",
        "type": "calc.right_branch",
        "display_name": "calc.right_branch"
      }
    ],
    "input_semantics": {
      "calc.scaled": [
        "scaled arithmetic value selected for the right branch"
      ]
    },
    "output_semantics": {
      "calc.right_branch": [
        "right branch value after subtracting penalty"
      ]
    },
    "examples": [],
    "params_schema": {
      "penalty": {
        "type": "number"
      }
    },
    "params_defaults": {
      "penalty": 0
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticRightKeyAdjustNode"
      }
    }
  ]
}
