{
  "kind": "node",
  "type_key": "sandbox.numeric_argv",
  "display_name": "解析数值 CLI 参数",
  "category": "sandbox",
  "description": "解析让渡的 argv，形成左右输入文件和结果文件路径。",
  "version": "0.1.0",
  "flow_kind": "io",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "cli.argv",
        "cardinality": "exactly_one",
        "display_name": "cli.argv"
      }
    ],
    "provides": [
      {
        "key": "cli.left_path",
        "type": "cli.left_path",
        "display_name": "cli.left_path"
      },
      {
        "key": "cli.right_path",
        "type": "cli.right_path",
        "display_name": "cli.right_path"
      },
      {
        "key": "cli.output_path",
        "type": "cli.output_path",
        "display_name": "cli.output_path"
      }
    ],
    "input_semantics": {
      "cli.argv": [
        "不含 argv0 和分隔符的原始业务参数。"
      ]
    },
    "output_semantics": {
      "cli.left_path": [
        "--left 指定的左侧数值文件。"
      ],
      "cli.right_path": [
        "--right 指定的右侧数值文件。"
      ],
      "cli.output_path": [
        "--output 指定的计算结果文件。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "cli.argv": {
            "key": "cli.argv",
            "type": "cli.argv",
            "value": [
              "--left",
              "left.txt",
              "--right",
              "right.txt",
              "--output",
              "sum.txt"
            ],
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.io"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_delegate_numeric_nodes.py",
        "export": "NumericArgvNode"
      }
    }
  ]
}
