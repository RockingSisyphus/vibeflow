{
  "kind": "node",
  "type_key": "semantic.copy_next",
  "display_name": "Semantic Copy Next",
  "category": "semantic",
  "description": "Copies loop.next back into loop.current for the next loop iteration.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "loop.next",
        "cardinality": "exactly_one",
        "display_name": "loop.next"
      }
    ],
    "provides": [
      {
        "key": "loop.current.copy",
        "type": "loop.current",
        "display_name": "loop.current.copy"
      }
    ],
    "input_semantics": {
      "loop.next": [
        "latest loop value to reuse"
      ]
    },
    "output_semantics": {
      "loop.current.copy": [
        "next loop iteration input"
      ]
    },
    "examples": [
      {
        "inputs": {
          "loop.next": {
            "key": "loop.next",
            "type": "loop.next",
            "value": 3,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticCopyNextNode"
      }
    }
  ]
}
