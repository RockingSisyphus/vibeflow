{
  "kind": "node",
  "type_key": "semantic.add_pair",
  "display_name": "Semantic Add Pair",
  "category": "semantic",
  "description": "Adds calc.a and calc.b into calc.sum for arithmetic acceptance flows.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "calc.a",
        "cardinality": "exactly_one",
        "display_name": "calc.a"
      },
      {
        "type": "calc.b",
        "cardinality": "exactly_one",
        "display_name": "calc.b"
      }
    ],
    "provides": [
      {
        "key": "calc.sum",
        "type": "calc.sum",
        "display_name": "calc.sum"
      }
    ],
    "input_semantics": {
      "calc.a": [
        "left numeric addend"
      ],
      "calc.b": [
        "right numeric addend"
      ]
    },
    "output_semantics": {
      "calc.sum": [
        "sum of calc.a and calc.b"
      ]
    },
    "examples": [
      {
        "inputs": {
          "calc.a": {
            "key": "calc.a",
            "type": "calc.a",
            "value": 2,
            "source_node": "example"
          },
          "calc.b": {
            "key": "calc.b",
            "type": "calc.b",
            "value": 5,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticAddPairNode"
      }
    }
  ]
}
