{
  "kind": "node",
  "type_key": "semantic.compare_gt",
  "display_name": "Semantic Compare Greater Than",
  "category": "semantic",
  "description": "Compares calc.c and calc.d and emits route.branch for left or right branch selection.",
  "version": "0.1.0",
  "flow_kind": "decision",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "calc.c",
        "cardinality": "exactly_one",
        "display_name": "calc.c"
      },
      {
        "type": "calc.d",
        "cardinality": "exactly_one",
        "display_name": "calc.d"
      }
    ],
    "provides": [
      {
        "key": "route.branch",
        "type": "route.branch",
        "display_name": "route.branch"
      }
    ],
    "input_semantics": {
      "calc.c": [
        "left comparison value"
      ],
      "calc.d": [
        "right comparison value"
      ]
    },
    "output_semantics": {
      "route.branch": [
        "left when calc.c > calc.d, otherwise right"
      ]
    },
    "examples": [
      {
        "inputs": {
          "calc.c": {
            "key": "calc.c",
            "type": "calc.c",
            "value": 9,
            "source_node": "example"
          },
          "calc.d": {
            "key": "calc.d",
            "type": "calc.d",
            "value": 4,
            "source_node": "example"
          }
        },
        "params": {}
      },
      {
        "inputs": {
          "calc.c": {
            "key": "calc.c",
            "type": "calc.c",
            "value": 1,
            "source_node": "example"
          },
          "calc.d": {
            "key": "calc.d",
            "type": "calc.d",
            "value": 4,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticCompareGtNode"
      }
    }
  ]
}
