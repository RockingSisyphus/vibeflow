{
  "kind": "node",
  "type_key": "sandbox.delegate_document",
  "display_name": "读取 CLI 文档输入",
  "description": "由 document 节点执行真实文件读取并形成业务文档内容。",
  "version": "0.1.0",
  "flow_kind": "document",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "cli.input_path",
        "cardinality": "exactly_one",
        "display_name": "cli.input_path"
      }
    ],
    "provides": [
      {
        "key": "document.message",
        "type": "document.message",
        "display_name": "document.message"
      }
    ],
    "input_semantics": {
      "cli.input_path": [
        "需要读取的业务输入文件路径。"
      ]
    },
    "output_semantics": {
      "document.message": [
        "从输入文档提取的 message 字符串。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "cli.input_path": {
            "key": "cli.input_path",
            "type": "cli.input_path",
            "value": "data.yaml",
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.document"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_delegate_cli_nodes.py",
        "export": "DelegateDocumentNode"
      }
    }
  ]
}
