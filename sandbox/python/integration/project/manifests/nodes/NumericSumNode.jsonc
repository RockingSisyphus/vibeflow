{
  "kind": "node",
  "type_key": "sandbox.numeric_sum",
  "display_name": "汇总三个数值",
  "description": "在 process 节点中对 stdin 与两个文件数值求和。",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "number.stdin",
        "cardinality": "exactly_one",
        "display_name": "number.stdin"
      },
      {
        "type": "number.left",
        "cardinality": "exactly_one",
        "display_name": "number.left"
      },
      {
        "type": "number.right",
        "cardinality": "exactly_one",
        "display_name": "number.right"
      }
    ],
    "provides": [
      {
        "key": "number.total",
        "type": "number.total",
        "display_name": "number.total"
      }
    ],
    "input_semantics": {
      "number.stdin": [
        "控制台输入的整数。"
      ],
      "number.left": [
        "左侧文件中的整数。"
      ],
      "number.right": [
        "右侧文件中的整数。"
      ]
    },
    "output_semantics": {
      "number.total": [
        "三个输入整数之和。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "number.stdin": {
            "key": "number.stdin",
            "type": "number.stdin",
            "value": 7,
            "source_node": "example"
          },
          "number.left": {
            "key": "number.left",
            "type": "number.left",
            "value": 11,
            "source_node": "example"
          },
          "number.right": {
            "key": "number.right",
            "type": "number.right",
            "value": 13,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_delegate_numeric_nodes.py",
        "export": "NumericSumNode"
      }
    }
  ]
}
