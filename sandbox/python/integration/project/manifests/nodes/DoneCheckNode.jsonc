{
  "kind": "node",
  "type_key": "sandbox.done_check",
  "display_name": "Done Check",
  "description": "Checks whether the loop reached its target.",
  "version": "0.1.0",
  "flow_kind": "decision",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.next",
        "cardinality": "exactly_one",
        "display_name": "value.next"
      }
    ],
    "provides": [
      {
        "key": "loop.done",
        "type": "loop.done",
        "display_name": "loop.done"
      }
    ],
    "input_semantics": {
      "value.next": [
        "next value"
      ]
    },
    "output_semantics": {
      "loop.done": [
        "whether the loop should stop"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.next": {
            "key": "value.next",
            "type": "value.next",
            "value": 3,
            "source_node": "example"
          }
        },
        "params": {
          "target": 3
        }
      }
    ],
    "params_schema": {
      "target": {
        "type": "number"
      }
    },
    "params_defaults": {
      "target": 3
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_loop_nodes.py",
        "export": "DoneCheckNode"
      }
    }
  ]
}
