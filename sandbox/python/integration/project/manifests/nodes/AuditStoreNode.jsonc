{
  "kind": "node",
  "type_key": "sandbox.audit_store",
  "display_name": "审计请求数据存储",
  "category": "sandbox",
  "description": "构造一条需要持久化的审计请求；在新内核中它只是数据存储形状的纯节点，不直接访问文件、数据库或网络。",
  "version": "0.1.0",
  "flow_kind": "data_store",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.final",
        "cardinality": "exactly_one",
        "display_name": "value.final"
      }
    ],
    "provides": [
      {
        "key": "effects.request",
        "type": "effects.request",
        "display_name": "effects.request"
      }
    ],
    "input_semantics": {
      "value.final": [
        "外部后处理后的最终业务数值，需要被记录到审计请求中。"
      ]
    },
    "output_semantics": {
      "effects.request": [
        "effects.request：结构化审计存储请求，描述应当记录的最终数值；真实写入动作由外部系统负责。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.final": {
            "key": "value.final",
            "type": "value.final",
            "value": 13,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.data_store"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_comprehensive_nodes.py",
        "export": "AuditStoreNode"
      }
    }
  ]
}
