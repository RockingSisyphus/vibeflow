{
  "kind": "node",
  "type_key": "sandbox.add_final_to_dead",
  "display_name": "Add Final To Dead",
  "description": "Extends the deliberately dead decision branch using a distinct, type-owned contract.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.final",
        "cardinality": "exactly_one",
        "display_name": "value.final"
      }
    ],
    "provides": [
      {
        "key": "value.dead",
        "type": "value.final",
        "display_name": "value.dead"
      }
    ],
    "input_semantics": {
      "value.final": [
        "value from the first dead-branch step"
      ]
    },
    "output_semantics": {
      "value.dead": [
        "continued value on the dead branch"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.final": {
            "key": "value.final",
            "type": "value.final",
            "value": 3,
            "source_node": "example"
          }
        },
        "params": {
          "delta": 1
        }
      }
    ],
    "params_schema": {
      "delta": {
        "type": "number"
      }
    },
    "params_defaults": {
      "delta": 1
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_math_nodes.py",
        "export": "AddFinalToDeadNode"
      }
    }
  ]
}
