{
  "kind": "node",
  "type_key": "semantic.increment_until",
  "display_name": "Semantic Increment Until",
  "category": "semantic",
  "description": "Adds a configured step to loop.current into loop.next.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "loop.current",
        "cardinality": "exactly_one",
        "display_name": "loop.current"
      }
    ],
    "provides": [
      {
        "key": "loop.next",
        "type": "loop.next",
        "display_name": "loop.next"
      }
    ],
    "input_semantics": {
      "loop.current": [
        "current loop value before increment"
      ]
    },
    "output_semantics": {
      "loop.next": [
        "loop.current plus step"
      ]
    },
    "examples": [
      {
        "inputs": {
          "loop.current": {
            "key": "loop.current",
            "type": "loop.current",
            "value": 1,
            "source_node": "example"
          }
        },
        "params": {
          "step": 2
        }
      }
    ],
    "params_schema": {
      "step": {
        "type": "number"
      }
    },
    "params_defaults": {
      "step": 1
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_semantic_nodes.py",
        "export": "SemanticIncrementUntilNode"
      }
    }
  ]
}
