{
  "kind": "node",
  "type_key": "sandbox.ordinary_callback",
  "display_name": "Ordinary Callback Warning",
  "category": "training",
  "description": "Deliberately invokes an envelope callback from an ordinary node so the advisory runtime-dispatch warning remains executable.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "callback.in",
        "cardinality": "exactly_one",
        "display_name": "callback.in"
      }
    ],
    "provides": [
      {
        "key": "value.out",
        "type": "value.out",
        "display_name": "value.out"
      }
    ],
    "input_semantics": {
      "callback.in": [
        "runtime callback or example scalar"
      ]
    },
    "output_semantics": {
      "value.out": [
        "callback result"
      ]
    },
    "examples": [
      {
        "inputs": {
          "callback.in": {
            "key": "callback.in",
            "type": "callback.in",
            "value": 7,
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_training_nodes.py",
        "export": "OrdinaryCallbackWarningNode"
      }
    }
  ]
}
