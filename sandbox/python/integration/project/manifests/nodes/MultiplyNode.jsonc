{
  "kind": "node",
  "type_key": "sandbox.multiply",
  "display_name": "Multiply",
  "description": "Multiplies value.out by a configured factor.",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "value.out"
      }
    ],
    "provides": [
      {
        "key": "value.final",
        "type": "value.final",
        "display_name": "value.final"
      }
    ],
    "input_semantics": {
      "value.out": [
        "value to multiply"
      ]
    },
    "output_semantics": {
      "value.final": [
        "final numeric value"
      ]
    },
    "examples": [
      {
        "inputs": {
          "value.out": {
            "key": "value.out",
            "type": "value.out",
            "value": 5,
            "source_node": "example"
          }
        },
        "params": {
          "factor": 2
        }
      }
    ],
    "params_schema": {
      "factor": {
        "type": "number"
      }
    },
    "params_defaults": {
      "factor": 2
    }
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_math_nodes.py",
        "export": "MultiplyNode"
      }
    }
  ]
}
