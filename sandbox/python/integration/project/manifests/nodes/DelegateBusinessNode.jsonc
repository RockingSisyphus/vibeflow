{
  "kind": "node",
  "type_key": "sandbox.delegate_business",
  "display_name": "处理 CLI 业务",
  "description": "在普通 process 节点中处理由 document 节点读取的内容。",
  "version": "0.1.0",
  "flow_kind": "process",
  "author": null,
  "tags": [
    "sandbox"
  ],
  "external": false,
  "contract": {
    "requires": [
      {
        "type": "document.message",
        "cardinality": "exactly_one",
        "display_name": "document.message"
      }
    ],
    "provides": [
      {
        "key": "business.message",
        "type": "business.message",
        "display_name": "business.message"
      }
    ],
    "input_semantics": {
      "document.message": [
        "输入文档中的原始消息。"
      ]
    },
    "output_semantics": {
      "business.message": [
        "完成核心业务处理的消息。"
      ]
    },
    "examples": [
      {
        "inputs": {
          "document.message": {
            "key": "document.message",
            "type": "document.message",
            "value": "hello",
            "source_node": "example"
          }
        },
        "params": {}
      }
    ],
    "params_schema": {},
    "params_defaults": {}
  },
  "rulesets": [
    "vibeflow.process"
  ],
  "implementations": [
    {
      "language": "python",
      "targets": [
        "python"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/legal_delegate_cli_nodes.py",
        "export": "DelegateBusinessNode"
      }
    }
  ]
}
