{
  "pipeline": {
    "inputs": [
      {
        "key": "calc.a",
        "type": "calc.a",
        "display_name": "Calc A",
        "required": true
      },
      {
        "key": "calc.b",
        "type": "calc.b",
        "display_name": "Calc B",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "add_pair",
        "definition_id": "semantic.add_pair",
        "display_name": "Add Pair",
        "description": "Runs add_pair."
      },
      {
        "factor": 3,
        "id": "scale",
        "definition_id": "semantic.scale",
        "display_name": "Scale",
        "description": "Runs scale."
      },
      {
        "offset": 1,
        "id": "finalize",
        "definition_id": "semantic.finalize",
        "display_name": "Finalize",
        "description": "Runs finalize."
      },
      {
        "id": "end",
        "definition_id": "semantic.final_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "add_pair"
      },
      {
        "from": "add_pair",
        "to": "scale"
      },
      {
        "from": "scale",
        "to": "finalize"
      },
      {
        "from": "finalize",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "calc.final",
        "cardinality": "exactly_one",
        "display_name": "Calc Final"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
