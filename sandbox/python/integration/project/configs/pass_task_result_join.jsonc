{
  "pipeline": {
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "seed",
        "definition_id": "sandbox.constant",
        "display_name": "seed",
        "description": "Executes the declared ordinary workflow node.",
        "value": 7
      },
      {
        "delta": 5,
        "id": "add",
        "definition_id": "sandbox.add",
        "display_name": "Add",
        "description": "Runs add."
      },
      {
        "id": "end",
        "definition_id": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "seed"
      },
      {
        "from": "add",
        "to": "end"
      },
      {
        "from": "seed",
        "to": "add"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Value Out"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
