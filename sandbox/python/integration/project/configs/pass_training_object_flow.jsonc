{
  "pipeline": {
    "inputs": [
      {
        "key": "train.model",
        "type": "train.model",
        "display_name": "Train Model",
        "required": true
      },
      {
        "key": "train.batch",
        "type": "train.batch",
        "display_name": "Train Batch",
        "required": true
      },
      {
        "key": "train.optimizer",
        "type": "train.optimizer",
        "display_name": "Train Optimizer",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "definition_id": "sandbox.training_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "id": "forward",
        "definition_id": "sandbox.forward_loss",
        "display_name": "Forward",
        "description": "Runs forward."
      },
      {
        "id": "backward",
        "definition_id": "sandbox.backward_grad",
        "display_name": "Backward",
        "description": "Runs backward."
      },
      {
        "id": "step",
        "definition_id": "sandbox.optimizer_step",
        "display_name": "Step",
        "description": "Runs step."
      },
      {
        "id": "metrics",
        "definition_id": "sandbox.training_metrics",
        "display_name": "Metrics",
        "description": "Runs metrics."
      },
      {
        "id": "end",
        "definition_id": "sandbox.training_metrics_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "forward"
      },
      {
        "from": "forward",
        "to": "backward"
      },
      {
        "from": "backward",
        "to": "step"
      },
      {
        "from": "step",
        "to": "metrics"
      },
      {
        "from": "metrics",
        "to": "end"
      },
      {
        "from": "forward",
        "to": "metrics"
      },
      {
        "from": "input",
        "to": "backward"
      },
      {
        "from": "input",
        "to": "step"
      }
    ],
    "outputs": [
      {
        "type": "train.metrics",
        "cardinality": "exactly_one",
        "display_name": "Train Metrics"
      },
      {
        "type": "train.grad",
        "cardinality": "optional_one",
        "display_name": "Train Grad"
      },
      {
        "type": "train.loss",
        "cardinality": "optional_one",
        "display_name": "Train Loss"
      },
      {
        "type": "train.step_report",
        "cardinality": "optional_one",
        "display_name": "Train Step Report"
      },
      {
        "type": "train.model_after",
        "cardinality": "optional_one",
        "display_name": "Train Model After"
      },
      {
        "type": "train.optimizer_after",
        "cardinality": "optional_one",
        "display_name": "Train Optimizer After"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
