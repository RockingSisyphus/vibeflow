{
  "pipeline": {
    "inputs": [
      {
        "key": "train.batch",
        "type": "train.batch",
        "display_name": "Train Batch",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "metrics",
        "definition_id": "sandbox.batch_metrics",
        "display_name": "Metrics",
        "description": "Runs metrics."
      },
      {
        "id": "end",
        "definition_id": "sandbox.training_metrics_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "metrics"
      },
      {
        "from": "metrics",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "train.metrics",
        "cardinality": "exactly_one",
        "display_name": "Train Metrics"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
