{
  "pipeline": {
    "inputs": [
      {
        "key": "calc.a",
        "type": "calc.a",
        "display_name": "Calc A",
        "required": true
      },
      {
        "key": "calc.b",
        "type": "calc.b",
        "display_name": "Calc B",
        "required": true
      },
      {
        "key": "calc.c",
        "type": "calc.c",
        "display_name": "Calc C",
        "required": true
      },
      {
        "key": "calc.d",
        "type": "calc.d",
        "display_name": "Calc D",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "add_pair",
        "definition_id": "semantic.add_pair",
        "display_name": "Add Pair",
        "description": "Runs add_pair."
      },
      {
        "factor": 3,
        "id": "scale",
        "definition_id": "semantic.scale",
        "display_name": "Scale",
        "description": "Runs scale."
      },
      {
        "id": "compare",
        "definition_id": "semantic.compare_gt",
        "display_name": "Compare",
        "description": "Runs compare."
      },
      {
        "bonus": 10,
        "id": "left_adjust",
        "definition_id": "semantic.left_adjust",
        "display_name": "Left Adjust",
        "description": "Runs left_adjust."
      },
      {
        "penalty": 6,
        "id": "right_adjust",
        "definition_id": "semantic.right_adjust",
        "display_name": "Right Adjust",
        "description": "Runs right_adjust."
      },
      {
        "id": "consume_branch",
        "definition_id": "semantic.branch_type_consumer",
        "display_name": "Consume Branch",
        "description": "Runs consume_branch."
      },
      {
        "id": "end",
        "definition_id": "semantic.branch_final_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "add_pair"
      },
      {
        "from": "start",
        "to": "compare"
      },
      {
        "from": "add_pair",
        "to": "scale"
      },
      {
        "from": "scale",
        "to": "left_adjust"
      },
      {
        "from": "scale",
        "to": "right_adjust"
      },
      {
        "from": "compare",
        "to": "left_adjust",
        "when": "route.branch == 'left'"
      },
      {
        "from": "compare",
        "to": "right_adjust",
        "when": "route.branch == 'right'"
      },
      {
        "from": "left_adjust",
        "to": "consume_branch"
      },
      {
        "from": "right_adjust",
        "to": "consume_branch"
      },
      {
        "from": "consume_branch",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "final_result",
        "cardinality": "exactly_one",
        "display_name": "Final Result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
