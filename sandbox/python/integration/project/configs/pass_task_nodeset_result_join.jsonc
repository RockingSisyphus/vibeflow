{
  "metadata": {
    "name": "pass.task_nodeset_result_join",
    "version": "0.1.0"
  },
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "definition_id": "sandbox.value_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "id": "composite",
        "definition_id": "math.add_five",
        "display_name": "composite",
        "description": "Executes the declared ordinary workflow node."
      },
      {
        "id": "end",
        "definition_id": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "composite"
      },
      {
        "from": "composite",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Value Out"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodeset_types/pass_task_nodeset_result_join/math_add_five.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
