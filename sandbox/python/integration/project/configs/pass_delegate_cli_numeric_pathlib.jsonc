{
  "pipeline": {
    "inputs": [
      {"key": "cli.argv", "type": "cli.argv", "display_name": "CLI Argv"}
    ],
    "outputs": [
      {"type": "cli.exit_code", "cardinality": "exactly_one", "display_name": "CLI Exit Code"}
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.start",
        "display_name": "Start",
        "description": "Starts the Path-based numeric CLI graph."
      },
      {
        "id": "parse_argv",
        "type_used": "sandbox.numeric_argv",
        "display_name": "Parse numeric argv",
        "description": "Parses the left, right, and output paths from delegated argv."
              },
      {
        "id": "read_stdin",
        "type_used": "sandbox.numeric_builtin_input",
        "display_name": "Read stdin with input",
        "description": "Reads one integer from the real stdin using input()."
      },
      {
        "id": "read_left",
        "type_used": "sandbox.numeric_path_left",
        "display_name": "Read left with Path",
        "description": "Reads the left integer using Path.read_text()."
              },
      {
        "id": "read_right",
        "type_used": "sandbox.numeric_open_right",
        "display_name": "Read right with open",
        "description": "Reads the right integer using builtins.open().readline()."
              },
      {
        "id": "sum_numbers",
        "type_used": "sandbox.numeric_sum",
        "display_name": "Sum three numbers",
        "description": "Adds the stdin, left-file, and right-file integers."
              },
      {
        "id": "write_file",
        "type_used": "sandbox.numeric_path_writer",
        "display_name": "Write result with Path",
        "description": "Writes the total using Path.write_text()."
              },
      {
        "id": "write_output",
        "type_used": "sandbox.numeric_print_output",
        "display_name": "Write console with print",
        "description": "Writes stdout with print and stderr with sys.stderr.write."
              },
      {
        "id": "end",
        "type_used": "sandbox.delegate_end",
        "display_name": "End",
        "description": "Ends after the numeric CLI exit code is formed.",
        "similar_to": {
          "node": "start",
          "relationship": "copy",
          "reason": "Both terminal calls intentionally use the same empty lifecycle implementation."
        }
      }
    ],
    "edges": [
      ["start", "parse_argv"],
      ["parse_argv", "read_stdin"],
      ["read_stdin", "read_left"],
      ["read_left", "read_right"],
      ["read_right", "sum_numbers"],
      ["sum_numbers", "write_file"],
      ["write_file", "write_output"],
      ["write_output", "end"],
      ["parse_argv", "read_left"],
      ["parse_argv", "read_right"],
      ["parse_argv", "write_file"],
      ["read_stdin", "sum_numbers"],
      ["read_left", "sum_numbers"],
      ["sum_numbers", "write_output"]
    ]
  }
}
