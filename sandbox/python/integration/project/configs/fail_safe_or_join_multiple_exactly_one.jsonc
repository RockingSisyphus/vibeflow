{
  "pipeline": {
    "nodes": [
      {
        "display_name": "Start",
        "description": "Starts a multiple-provider runtime join failure.",
        "id": "start",
        "definition_id": "sandbox.start"
      },
      {
        "display_name": "Left Value",
        "description": "Provides one active value.in source.",
        "value": 3,
        "id": "left_value",
        "definition_id": "semantic.left_value"
      },
      {
        "display_name": "Right Value",
        "description": "Provides a second active value.in source.",
        "value": 4,
        "id": "right_value",
        "definition_id": "semantic.right_value"
      },
      {
        "display_name": "Conflicting Join",
        "description": "Requires exactly one value.in but receives two active providers.",
        "id": "join",
        "definition_id": "semantic.join_passthrough"
      },
      {
        "display_name": "End",
        "description": "Would end if the join had one selected value.",
        "id": "end",
        "definition_id": "semantic.value_end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "left_value"
      },
      {
        "from": "start",
        "to": "right_value"
      },
      {
        "from": "left_value",
        "to": "join"
      },
      {
        "from": "right_value",
        "to": "join"
      },
      {
        "from": "join",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "optional_one",
        "display_name": "Value Out"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
