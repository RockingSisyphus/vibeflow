{
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "nodes": [
      {
        "display_name": "Start",
        "description": "Starts the decision dead-end fixture.",
        "id": "start",
        "definition_id": "sandbox.start"
      },
      {
        "display_name": "Prepare Value",
        "description": "Produces value.out for the route decision.",
        "delta": 1,
        "id": "prepare",
        "definition_id": "sandbox.add"
      },
      {
        "display_name": "Route",
        "description": "Routes either to the valid end branch or to a dead end.",
        "threshold": 10,
        "id": "route",
        "definition_id": "sandbox.route_decision"
      },
      {
        "display_name": "Dead Branch",
        "description": "A decision branch that cannot reach an end terminal.",
        "delta": 1,
        "id": "dead",
        "definition_id": "sandbox.add_out"
      },
      {
        "display_name": "Dead Sink",
        "description": "Continues the dead branch without ever reaching an end terminal.",
        "delta": 1,
        "id": "sink",
        "definition_id": "sandbox.add_final_to_dead"
      },
      {
        "display_name": "End",
        "description": "Ends the valid external branch.",
        "id": "end",
        "definition_id": "sandbox.out_value_end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "prepare"
      },
      {
        "from": "prepare",
        "to": "route"
      },
      {
        "from": "route",
        "to": "dead",
        "when": "flow.route == 'again'"
      },
      {
        "from": "dead",
        "to": "sink"
      },
      {
        "from": "route",
        "to": "end",
        "when": "flow.route == 'external'"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "optional_one",
        "display_name": "Value Out"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
