{
  "pipeline": {
    "execution_lock": {
      "key": "sandbox.global-state.serial"
    },
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Starts the dedicated global-state sandbox case."
      },
      {
        "id": "state",
        "definition_id": "sandbox.global_state_probe",
        "display_name": "Global State Probe",
        "description": "Changes audited process-local ambient state.",
        "execution_lock": {
          "key": "sandbox.global-state.serial"
        }
      },
      {
        "id": "end",
        "definition_id": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Ends after the global-state probe."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "state"
      },
      {
        "from": "state",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Value Out"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
