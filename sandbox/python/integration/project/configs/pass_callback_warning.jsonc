{
  "pipeline": {
    "inputs": [
      {
        "key": "callback.in",
        "type": "callback.in",
        "display_name": "Runtime Callback",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Starts the ordinary Callback warning example."
      },
      {
        "id": "callback",
        "definition_id": "sandbox.ordinary_callback",
        "display_name": "Ordinary Callback",
        "description": "Invokes an envelope Callback without hiding or blocking it."
      },
      {
        "id": "end",
        "definition_id": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Ends after the Callback result is available."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "callback"
      },
      {
        "from": "callback",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Callback Result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
