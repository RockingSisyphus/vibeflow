{
  "pipeline": {
    "inputs": [
      {
        "key": "train.model",
        "type": "train.model",
        "display_name": "Train Model",
        "required": true
      },
      {
        "key": "train.batch",
        "type": "train.batch",
        "display_name": "Train Batch",
        "required": true
      },
      {
        "key": "train.optimizer",
        "type": "train.optimizer",
        "display_name": "Train Optimizer",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "definition_id": "sandbox.training_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "id": "train",
        "definition_id": "training.step",
        "display_name": "Train",
        "description": "Runs train."
      },
      {
        "id": "end",
        "definition_id": "sandbox.training_metrics_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "train"
      },
      {
        "from": "train",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "train.metrics",
        "cardinality": "exactly_one",
        "display_name": "Train Metrics"
      },
      {
        "type": "train.step_report",
        "cardinality": "optional_one",
        "display_name": "Train Step Report"
      },
      {
        "type": "train.model_after",
        "cardinality": "optional_one",
        "display_name": "Train Model After"
      },
      {
        "type": "train.optimizer_after",
        "cardinality": "optional_one",
        "display_name": "Train Optimizer After"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodeset_types/pass_training_nodeset_object_flow/training_step.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
