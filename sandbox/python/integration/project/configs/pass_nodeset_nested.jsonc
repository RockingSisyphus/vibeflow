{
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "definition_id": "sandbox.value_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "node_configs": {
          "first.add": {
            "delta": 4
          },
          "second": {
            "delta": 6
          }
        },
        "id": "add_two",
        "definition_id": "math.add_two",
        "display_name": "Add Two",
        "description": "Runs add_two."
      },
      {
        "id": "end",
        "definition_id": "sandbox.final_value_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "add_two"
      },
      {
        "from": "add_two",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.final",
        "cardinality": "exactly_one",
        "display_name": "Value Final"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodeset_types/pass_nodeset_nested/math_add_one.jsonc"
    },
    {
      "path": "nodeset_types/pass_nodeset_nested/math_add_two.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
