{
  "metadata": {
    "name": "pass.async_nodeset_result_key_join",
    "version": "0.1.0"
  },
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "type_used": "sandbox.value_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "id": "composite",
        "type_used": "task.launch.math_add_five.waited",
        "display_name": "任务管理：Composite",
        "description": "Starts an explicitly declared workflow-owned task.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "math.add_five",
            "display_name": "Composite",
            "description": "Runs composite."
          }
        }
      },
      {
        "id": "composite_join",
        "type_used": "task.join.math_add_five",
        "display_name": "任务管理：等待 Composite",
        "description": "Waits for actual task execution and cleanup, then returns its declared outputs."
      },
      {
        "id": "end",
        "type_used": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "composite"
      },
      {
        "from": "composite_join",
        "to": "end"
      },
      {
        "from": "composite",
        "to": "composite_join"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Value Out"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodesets/pass_async_nodeset_result_key_join/math_add_five.jsonc"
    }
  ],
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.py",
        "export": "plugin"
      }
    }
  ]
}
