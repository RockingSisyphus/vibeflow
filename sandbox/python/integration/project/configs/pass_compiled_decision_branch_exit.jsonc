{
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "max_steps": 20,
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "definition_id": "sandbox.value_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "offset": 1,
        "id": "prepare",
        "definition_id": "sandbox.prepare_value",
        "display_name": "Prepare",
        "description": "Runs prepare."
      },
      {
        "factor": 2,
        "id": "compute",
        "definition_id": "sandbox.core_compute",
        "display_name": "Compute",
        "description": "Runs compute."
      },
      {
        "threshold": 10,
        "id": "route",
        "definition_id": "sandbox.route_decision",
        "display_name": "Route",
        "description": "Runs route."
      },
      {
        "bonus": 5,
        "id": "external",
        "definition_id": "sandbox.external_boost",
        "display_name": "External",
        "description": "Runs external."
      },
      {
        "id": "end",
        "definition_id": "sandbox.final_value_end",
        "display_name": "End",
        "description": "Runs end."
      },
      {
        "display_name": "Again Branch End",
        "description": "Terminates the inactive again branch in the acyclic compiled fixture.",
        "id": "again_end",
        "definition_id": "sandbox.start"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "prepare"
      },
      {
        "from": "prepare",
        "to": "compute"
      },
      {
        "from": "compute",
        "to": "route"
      },
      {
        "from": "compute",
        "to": "external"
      },
      {
        "from": "route",
        "to": "external",
        "when": "flow.route == 'external'"
      },
      {
        "from": "route",
        "to": "again_end",
        "when": "flow.route == 'again'"
      },
      {
        "from": "external",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.final",
        "cardinality": "exactly_one",
        "display_name": "Value Final"
      },
      {
        "type": "flow.route",
        "cardinality": "optional_one",
        "display_name": "Flow Route"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
