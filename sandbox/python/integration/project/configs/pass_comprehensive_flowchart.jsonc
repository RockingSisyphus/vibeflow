{
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "execution_lock": {
          "key": "sandbox.runtime.mode"
        },


        "id": "runtime_mode",
        "type_used": "sandbox.configure_runtime_mode",
        "display_name": "Runtime Mode",
        "description": "Configures audited process-local ambient state."
      },
      {


        "id": "input",
        "type_used": "sandbox.value_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {


        "offset": 1,
        "id": "prepare",
        "type_used": "sandbox.prepare_value",
        "display_name": "Prepare",
        "description": "Runs prepare."
      },
      {


        "id": "core",
        "type_used": "comprehensive.core",
        "display_name": "Core",
        "description": "Runs core."
      },
      {


        "threshold": 8,
        "id": "route",
        "type_used": "sandbox.route_decision",
        "display_name": "Route",
        "description": "Runs route."
      },
      {


        "bonus": 5,
        "id": "external",
        "type_used": "sandbox.external_boost",
        "display_name": "External",
        "description": "Runs external."
      },
      {


        "id": "store",
        "type_used": "sandbox.audit_store",
        "display_name": "Store",
        "description": "Runs store."
      },
      {


        "id": "document",
        "type_used": "sandbox.report_document",
        "display_name": "Document",
        "description": "Runs document."
      },
      {


        "id": "output",
        "type_used": "sandbox.report_output",
        "display_name": "Output",
        "description": "Runs output."
      },
      {

        "id": "end",
        "type_used": "sandbox.report_end",
        "display_name": "End",
        "description": "Runs end."
      },
      {
        "display_name": "Again Branch End",
        "description": "Terminates the inactive again branch in the acyclic comprehensive fixture.",
        "id": "again_end",
        "type_used": "sandbox.start"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "runtime_mode"
      },
      {
        "from": "runtime_mode",
        "to": "prepare"
      },
      {
        "from": "prepare",
        "to": "core"
      },
      {
        "from": "core",
        "to": "route"
      },
      {
        "from": "core",
        "to": "external"
      },
      {
        "from": "route",
        "to": "external",
        "when": "flow.route == 'external'"
      },
      {
        "from": "route",
        "to": "again_end",
        "when": "flow.route == 'again'"
      },
      {
        "from": "external",
        "to": "store"
      },
      {
        "from": "external",
        "to": "document"
      },
      {
        "from": "store",
        "to": "document"
      },
      {
        "from": "document",
        "to": "output"
      },
      {
        "from": "output",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "io.output",
        "cardinality": "exactly_one",
        "display_name": "Io Output"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodesets/pass_comprehensive_flowchart/comprehensive_core.jsonc"
    }
  ]
}
