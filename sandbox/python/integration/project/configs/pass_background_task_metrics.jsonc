{
  "pipeline": {
    "inputs": [
      {
        "key": "train.batch",
        "type": "train.batch",
        "display_name": "Train Batch",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "metrics",
        "definition_id": "sandbox.batch_metrics",
        "display_name": "metrics",
        "description": "Executes the declared ordinary workflow node."
      },
      {
        "value": 4,
        "id": "seed",
        "definition_id": "sandbox.constant",
        "display_name": "Seed",
        "description": "Runs seed."
      },
      {
        "delta": 6,
        "id": "add",
        "definition_id": "sandbox.add",
        "display_name": "Add",
        "description": "Runs add."
      },
      {
        "id": "end",
        "definition_id": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Runs end.",
        "join_policy": "all"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "metrics"
      },
      {
        "from": "start",
        "to": "seed"
      },
      {
        "from": "seed",
        "to": "add"
      },
      {
        "from": "add",
        "to": "end"
      },
      {
        "from": "metrics",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Value Out"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
