{
  "pipeline": {
    "entry_mode": "async",
    "nodes": [
      {
        "id": "receive",
        "type_used": "vibeflow.io",
        "display_name": "Receive Number",
        "description": "Receives one number from the sandbox input Port.",
        "provides": [
          {
            "key": "value.in",
            "type": "value.in",
            "display_name": "Value In"
          }
        ],
        "io": {
          "operation": "receive",
          "port": "sandbox.math.in"
        }
      },
      {
        "id": "add",
        "type_used": "sandbox.add",
        "display_name": "Add Two",
        "description": "Uses the shared Python math base_lib to add two.",
        "requires": [
          {
            "type": "value.in",
            "cardinality": "exactly_one",
            "display_name": "Value In"
          }
        ],
        "provides": [
          {
            "key": "value.out",
            "type": "value.out",
            "display_name": "Value Out"
          }
        ],
        "config": {
          "delta": 2
        }
      },
      {
        "id": "multiply",
        "type_used": "sandbox.multiply",
        "display_name": "Multiply Three",
        "description": "Uses the shared Python math base_lib to multiply by three.",
        "requires": [
          {
            "type": "value.out",
            "cardinality": "exactly_one",
            "display_name": "Value Out"
          }
        ],
        "provides": [
          {
            "key": "value.final",
            "type": "value.final",
            "display_name": "Final Value"
          }
        ],
        "config": {
          "factor": 3
        }
      },
      {
        "id": "send",
        "type_used": "vibeflow.io",
        "display_name": "Send Result",
        "description": "Sends the final value to the sandbox output Port.",
        "requires": [
          {
            "type": "value.final",
            "cardinality": "exactly_one",
            "display_name": "Final Value"
          }
        ],
        "io": {
          "operation": "send",
          "port": "sandbox.math.out"
        }
      }
    ],
    "edges": [
      ["receive", "add"],
      ["add", "multiply"],
      ["multiply", "send"]
    ],
    "outputs": [
      {
        "type": "value.final",
        "cardinality": "exactly_one",
        "display_name": "Final Value"
      }
    ]
  }
}
