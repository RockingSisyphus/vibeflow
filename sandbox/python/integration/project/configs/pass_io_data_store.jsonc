{
  "pipeline": {
    "inputs": [
      {
        "key": "io.result",
        "type": "io.result",
        "display_name": "Io Result",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "input",
        "definition_id": "sandbox.io_input",
        "display_name": "Input",
        "description": "Runs input."
      },
      {
        "value": 5,
        "id": "request",
        "definition_id": "sandbox.effect_request",
        "display_name": "Request",
        "description": "Runs request."
      },
      {
        "delta": 1,
        "id": "add_result",
        "definition_id": "sandbox.io_result_add",
        "display_name": "Add Result",
        "description": "Runs add_result."
      },
      {
        "id": "end",
        "definition_id": "sandbox.final_value_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "request"
      },
      {
        "from": "add_result",
        "to": "end"
      },
      {
        "from": "input",
        "to": "add_result"
      },
      {
        "from": "request",
        "to": "add_result"
      }
    ],
    "outputs": [
      {
        "type": "value.final",
        "cardinality": "exactly_one",
        "display_name": "Value Final"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
