{
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "nodes": [
      {
        "display_name": "Start",
        "description": "Starts the forbidden decision-cycle fixture.",
        "id": "start",
        "definition_id": "sandbox.start"
      },
      {
        "display_name": "Input",
        "description": "Reads the initial loop value.",
        "id": "input",
        "definition_id": "sandbox.value_input"
      },
      {
        "display_name": "Increment",
        "description": "Advances the retry value.",
        "id": "increment",
        "definition_id": "sandbox.increment"
      },
      {
        "display_name": "Done Check",
        "description": "Routes to either repeat or exit.",
        "target": 2,
        "id": "done",
        "definition_id": "sandbox.done_check"
      },
      {
        "display_name": "Copy Back",
        "description": "Copies value.next back to value.in for the forbidden graph edge cycle.",
        "id": "copy",
        "definition_id": "sandbox.copy_back"
      },
      {
        "display_name": "End",
        "description": "Shows that even an exit branch does not make ordinary cycles legal.",
        "id": "end",
        "definition_id": "sandbox.next_value_end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "input"
      },
      {
        "from": "input",
        "to": "increment"
      },
      {
        "from": "increment",
        "to": "done"
      },
      {
        "from": "done",
        "to": "copy",
        "when": "loop.done == false"
      },
      {
        "from": "done",
        "to": "end",
        "when": "loop.done == true"
      },
      {
        "from": "copy",
        "to": "increment"
      }
    ],
    "outputs": [
      {
        "type": "value.next",
        "cardinality": "exactly_one",
        "display_name": "Value Next"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "good_math",
      "good_chain_a",
      "sandbox_arithmetic"
    ]
  }
}
