{
  "pipeline": {
    "inputs": [
      {
        "key": "value.in",
        "type": "value.in",
        "display_name": "Value In",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "increment",
        "definition_id": "sandbox.increment",
        "display_name": "Increment",
        "description": "Runs increment."
      },
      {
        "id": "copy",
        "definition_id": "sandbox.copy_back",
        "display_name": "Copy",
        "description": "Runs copy."
      }
    ],
    "loops": [
      {
        "name": "old",
        "edges": [
          [
            "copy",
            "increment"
          ]
        ],
        "max_iterations": 2
      }
    ],
    "outputs": [
      {
        "type": "value.in",
        "cardinality": "exactly_one",
        "display_name": "Value In"
      },
      {
        "type": "value.next",
        "cardinality": "exactly_one",
        "display_name": "Value Next"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ]
}
