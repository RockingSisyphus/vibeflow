{
  "pipeline": {
    "inputs": [
      {
        "key": "train.model",
        "type": "train.model",
        "display_name": "Train Model"
      },
      {
        "key": "train.batch",
        "type": "train.batch",
        "display_name": "Train Batch"
      },
      {
        "key": "train.optimizer",
        "type": "train.optimizer",
        "display_name": "Train Optimizer"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {


        "id": "training_input",
        "type_used": "sandbox.training_input",
        "display_name": "Training Input",
        "description": "Runs training_input."
      },
      {


        "id": "training_step",
        "type_used": "training.step",
        "display_name": "Training Step",
        "description": "Runs training_step."
      },
      {

        "id": "end",
        "type_used": "sandbox.training_metrics_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "training_input"
      },
      {
        "from": "training_input",
        "to": "training_step"
      },
      {
        "from": "training_step",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "train.metrics",
        "cardinality": "exactly_one",
        "display_name": "Train Metrics"
      },
      {
        "type": "train.step_report",
        "cardinality": "optional_one",
        "display_name": "Train Step Report"
      },
      {
        "type": "train.model_after",
        "cardinality": "optional_one",
        "display_name": "Train Model After"
      },
      {
        "type": "train.optimizer_after",
        "cardinality": "optional_one",
        "display_name": "Train Optimizer After"
      }
    ]
  },
  "nodeset_imports": [
    {
      "path": "nodesets/pass_execution_plan_training_nodeset/training_step.jsonc"
