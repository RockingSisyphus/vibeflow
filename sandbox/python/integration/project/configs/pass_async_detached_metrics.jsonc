{
  "pipeline": {
    "inputs": [
      {
        "key": "train.batch",
        "type": "train.batch",
        "display_name": "Train Batch",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.start",
        "display_name": "Start",
        "description": "Runs start."
      },
      {
        "id": "metrics",
        "type_used": "task.launch.sandbox_batch_metrics.background",
        "display_name": "任务管理：Metrics",
        "description": "Starts an explicitly declared workflow-owned task.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "sandbox.batch_metrics",
            "display_name": "Metrics",
            "description": "Runs metrics."
          }
        }
      },
      {
        "value": 4,
        "id": "seed",
        "type_used": "sandbox.constant",
        "display_name": "Seed",
        "description": "Runs seed."
      },
      {
        "delta": 6,
        "id": "add",
        "type_used": "sandbox.add",
        "display_name": "Add",
        "description": "Runs add."
      },
      {
        "id": "end",
        "type_used": "sandbox.out_value_end",
        "display_name": "End",
        "description": "Runs end."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "metrics"
      },
      {
        "from": "start",
        "to": "seed"
      },
      {
        "from": "seed",
        "to": "add"
      },
      {
        "from": "add",
        "to": "end"
      },
      {
        "from": "metrics",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "value.out",
        "cardinality": "exactly_one",
        "display_name": "Value Out"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.py",
        "export": "plugin"
      }
    }
  ]
}
