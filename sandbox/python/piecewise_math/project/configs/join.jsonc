{
  "pipeline": {
    "inputs": [
      {
        "key": "a",
        "type": "a",
        "display_name": "a",
        "required": true
      },
      {
        "key": "b",
        "type": "b",
        "display_name": "b",
        "required": true
      },
      {
        "key": "c",
        "type": "c",
        "display_name": "c",
        "required": true
      },
      {
        "key": "d",
        "type": "d",
        "display_name": "d",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "piecewise.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "u",
        "definition_id": "piecewise.sum_u",
        "display_name": "u",
        "description": "u"
      },
      {
        "id": "v",
        "definition_id": "piecewise.sum_v",
        "display_name": "v",
        "description": "v"
      },
      {
        "id": "compare",
        "definition_id": "piecewise.compare",
        "display_name": "compare",
        "description": "compare"
      },
      {
        "id": "left",
        "definition_id": "piecewise.left",
        "display_name": "left",
        "description": "left"
      },
      {
        "id": "right",
        "definition_id": "piecewise.right",
        "display_name": "right",
        "description": "right"
      },
      {
        "id": "finish",
        "definition_id": "piecewise.finish",
        "display_name": "finish",
        "description": "finish",
        "join_policy": "any_active"
      },
      {
        "id": "end",
        "definition_id": "piecewise.boundary",
        "display_name": "end",
        "description": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "u"
      },
      {
        "from": "start",
        "to": "v"
      },
      {
        "from": "u",
        "to": "compare"
      },
      {
        "from": "v",
        "to": "compare"
      },
      {
        "from": "u",
        "to": "left"
      },
      {
        "from": "v",
        "to": "right"
      },
      {
        "from": "compare",
        "to": "left",
        "when": "route == 'left'"
      },
      {
        "from": "compare",
        "to": "right",
        "when": "route == 'right'"
      },
      {
        "from": "left",
        "to": "finish"
      },
      {
        "from": "right",
        "to": "finish"
      },
      {
        "from": "finish",
        "to": "end"
      },
      {
        "from": "u",
        "to": "finish"
      }
    ],
    "outputs": [
      {
        "type": "result",
        "display_name": "result",
        "cardinality": "exactly_one"
      },
      {
        "type": "selected.key",
        "display_name": "selected.key",
        "cardinality": "exactly_one"
      },
      {
        "type": "u",
        "display_name": "u",
        "cardinality": "exactly_one"
      },
      {
        "type": "selected_w",
        "display_name": "selected_w",
        "cardinality": "optional_one"
      },
      {
        "type": "v",
        "display_name": "v",
        "cardinality": "exactly_one"
      },
      {
        "type": "route",
        "display_name": "route",
        "cardinality": "exactly_one"
      }
    ]
  },
  "base_lib": {
    "modules": [
      "piecewise.math"
    ]
  }
}
