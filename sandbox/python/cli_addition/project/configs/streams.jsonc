{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.py",
        "export": "plugin"
      }
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "cli.argv",
        "type": "cli.argv",
        "display_name": "cli.argv",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "addition.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "parse_argv",
        "type_used": "addition.argv",
        "display_name": "parse_argv",
        "description": "parse_argv"
      },
      {
        "id": "read_stdin",
        "type_used": "addition.stream_input",
        "display_name": "read_stdin",
        "description": "read_stdin"
      },
      {
        "id": "read_left",
        "type_used": "addition.open_left",
        "display_name": "read_left",
        "description": "read_left"
      },
      {
        "id": "read_right",
        "type_used": "addition.open_right",
        "display_name": "read_right",
        "description": "read_right"
      },
      {
        "id": "sum_numbers",
        "type_used": "addition.sum",
        "display_name": "sum_numbers",
        "description": "sum_numbers"
      },
      {
        "id": "write_file",
        "type_used": "addition.open_write",
        "display_name": "write_file",
        "description": "write_file"
      },
      {
        "id": "write_output",
        "type_used": "addition.streams",
        "display_name": "write_output",
        "description": "write_output"
      },
      {
        "id": "end",
        "type_used": "addition.boundary",
        "display_name": "end",
        "description": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "parse_argv"
      },
      {
        "from": "parse_argv",
        "to": "read_stdin"
      },
      {
        "from": "read_stdin",
        "to": "read_left"
      },
      {
        "from": "read_left",
        "to": "read_right"
      },
      {
        "from": "read_right",
        "to": "sum_numbers"
      },
      {
        "from": "sum_numbers",
        "to": "write_file"
      },
      {
        "from": "write_file",
        "to": "write_output"
      },
      {
        "from": "write_output",
        "to": "end"
      },
      {
        "from": "parse_argv",
        "to": "write_file"
      },
      {
        "from": "parse_argv",
        "to": "write_output"
      },
      {
        "from": "read_stdin",
        "to": "sum_numbers"
      },
      {
        "from": "sum_numbers",
        "to": "write_output"
      },
      {
        "from": "parse_argv",
        "to": "read_left"
      },
      {
        "from": "parse_argv",
        "to": "read_right"
      },
      {
        "from": "read_left",
        "to": "sum_numbers"
      }
    ],
    "outputs": [
      {
        "type": "cli.exit_code",
        "cardinality": "exactly_one",
        "display_name": "cli.exit_code",
        "as": "cli.exit_code"
      }
    ]
  }
}
