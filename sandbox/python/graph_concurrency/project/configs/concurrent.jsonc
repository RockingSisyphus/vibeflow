{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.py"
      }
    }
  ],
  "rulesets": [],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "scenario",
        "type": "scenario",
        "required": true,
        "display_name": "Scenario"
      }
    ],
    "outputs": [
