{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.py",
        "export": "plugin"
      }
    }
  ],
  "rulesets": [
    "vibeflow.workflow"
  ],
  "nodeset_imports": [
    {
      "path": "nodeset_types/affine.jsonc"
    },
    {
      "path": "nodeset_types/prepare.jsonc"
    },
    {
      "path": "nodeset_types/loop_body.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "math.offset",
        "type": "math.offset",
        "display_name": "math.offset",
        "required": false
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "math.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "offset",
        "definition_id": "math.offset",
        "display_name": "offset",
        "description": "offset"
      },
      {
        "id": "receive",
        "definition_id": "math.port_receive_0",
        "display_name": "receive",
        "description": "receive",
        "config": {
          "port": "math.in"
        }
      },
      {
        "id": "prepare",
        "definition_id": "math.prepare",
        "display_name": "prepare",
        "description": "prepare",
        "node_configs": {
          "inner.affine": {
            "gain": 3,
            "shift": 2
          },
          "subtract": {
            "amount": 3
          }
        }
      },
      {
        "id": "companion",
        "definition_id": "math.companion",
        "display_name": "companion",
        "description": "companion"
      },
      {
        "id": "route",
        "definition_id": "math.route",
        "display_name": "route",
        "description": "route"
      },
      {
        "id": "square",
        "definition_id": "math.square",
        "display_name": "square",
        "description": "square"
      },
      {
        "id": "negative",
        "definition_id": "math.negative",
        "display_name": "negative",
        "description": "negative"
      },
      {
        "id": "choice",
        "definition_id": "math.choice",
        "display_name": "choice",
        "description": "choice",
        "join_policy": "any_active"
      },
      {
        "id": "join",
        "definition_id": "math.join",
        "display_name": "join",
        "description": "join",
        "join_policy": "all"
      },
      {
        "id": "loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "loop",
        "description": "loop",
        "requires": [
          {
            "type": "math.value",
            "cardinality": "exactly_one",
            "display_name": "math.value"
          },
          {
            "type": "math.counter",
            "cardinality": "exactly_one",
            "display_name": "math.counter"
          }
        ],
        "provides": [
          {
            "key": "loop_result",
            "type": "math.loop_result",
            "display_name": "loop_result"
          },
          {
            "key": "history",
            "type": "math.history",
            "display_name": "history"
          },
          {
            "key": "iterations",
            "type": "math.iterations",
            "display_name": "iterations"
          }
        ],
        "loop": {
          "body": "math.loop_body",
          "max_iterations": 5,
          "stop_when": {
            "from": "done",
            "equals": true
          },
          "carry": [
            {
              "from": "math.value",
              "as": "math.value",
              "update": "next"
            },
            {
              "from": "math.counter",
              "as": "math.counter",
              "update": "counter"
            }
          ],
          "collect": [
            {
              "from": "next",
              "as": "history"
            }
          ],
          "outputs": [
            {
              "from": "math.value",
              "as": "loop_result"
            },
            {
              "from": "history",
              "as": "history"
            },
            {
              "from": "loop.iterations",
              "as": "iterations"
            }
          ]
        }
      },
      {
        "id": "finish",
        "definition_id": "math.finish",
        "display_name": "finish",
        "description": "finish",
        "join_policy": "all"
      },
      {
        "id": "send",
        "definition_id": "math.port_send_1",
        "display_name": "send",
        "description": "send",
        "config": {
          "port": "math.out"
        }
      },
      {
        "id": "send_end",
        "definition_id": "math.boundary",
        "display_name": "End",
        "description": "Explicit end after sending a host value."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "receive"
      },
      {
        "from": "start",
        "to": "offset"
      },
      {
        "from": "offset",
        "to": "finish"
      },
      {
        "from": "receive",
        "to": "prepare"
      },
      {
        "from": "receive",
        "to": "companion"
      },
      {
        "from": "prepare",
        "to": "route"
      },
      {
        "from": "route",
        "to": "square",
        "when": "nonnegative == true"
      },
      {
        "from": "route",
        "to": "negative",
        "when": "nonnegative == false"
      },
      {
        "from": "square",
        "to": "choice"
      },
      {
        "from": "negative",
        "to": "choice"
      },
      {
        "from": "choice",
        "to": "join"
      },
      {
        "from": "companion",
        "to": "join"
      },
      {
        "from": "join",
        "to": "loop"
      },
      {
        "from": "loop",
        "to": "finish"
      },
      {
        "from": "finish",
        "to": "send"
      },
      [
        "send",
        "send_end"
      ]
    ],
    "outputs": [
      {
        "type": "math.result",
        "cardinality": "exactly_one",
        "display_name": "math.result",
        "as": "result"
      },
      {
        "type": "math.history",
        "cardinality": "exactly_one",
        "display_name": "math.history",
        "as": "history"
      },
      {
        "type": "math.iterations",
        "cardinality": "exactly_one",
        "display_name": "math.iterations",
        "as": "iterations"
      }
    ]
  }
}
