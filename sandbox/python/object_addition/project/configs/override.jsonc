      },
      {
        "type": "object.snapshot",
        "cardinality": "exactly_one",
        "display_name": "object.snapshot",
        "as": "object.snapshot"
      },
      {
        "type": "object.metadata",
        "cardinality": "exactly_one",
        "display_name": "object.metadata",
        "as": "object.metadata"
      },
      {
        "type": "object.value",
        "cardinality": "exactly_one",
        "display_name": "object.value",
        "as": "object.value"
      },
      {
        "type": "object.done",
        "cardinality": "exactly_one",
        "display_name": "object.done",
        "as": "object.done"
