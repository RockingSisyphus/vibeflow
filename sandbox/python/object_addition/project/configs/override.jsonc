        "key": "object.box",
        "type": "object.box",
        "display_name": "object.box",
        "required": true
      },
      {
        "key": "object.counter",
        "type": "object.counter",
        "display_name": "object.counter",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "addition.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "step",
        "definition_id": "addition.step",
        "display_name": "step",
        "description": "step",
        "node_configs": {
          "add": {
            "delta": 8
          }
        }
      },
      {
        "id": "end",
        "definition_id": "addition.boundary",
        "display_name": "end",
        "description": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "step"
      },
      {
        "from": "step",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "object.box_after",
        "cardinality": "exactly_one",
