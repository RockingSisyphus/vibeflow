{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/addition/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "nodeset_imports": [
    {
      "path": "nodeset_types/port_body.jsonc"
    }
  ],
  "pipeline": {
    "inputs": [],
    "nodes": [
      {
        "id": "start",
        "definition_id": "addition.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "loop",
        "description": "loop",
        "requires": [],
        "provides": [],
        "loop": {
          "body": "addition.port_body",
          "max_iterations": null
        }
      },
      {
        "id": "open",
        "definition_id": "addition.session.open",
        "display_name": "open",
        "description": "Open the author-owned port API"
      },
      {
        "id": "cleanup_start",
        "definition_id": "addition.boundary",
        "display_name": "cleanup_start",
        "description": "Cleanup entry"
      },
      {
        "id": "close",
        "definition_id": "addition.session.close",
        "display_name": "close",
        "description": "Close the author-owned port API"
      },
      {
        "id": "cleanup_end",
        "definition_id": "addition.boundary",
        "display_name": "cleanup_end",
        "description": "Cleanup completed",
        "similar_to": {
          "node": "cleanup_start",
          "relationship": "copy",
          "reason": "Empty terminal boundary"
        }
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "open"
      },
      {
        "from": "open",
        "to": "loop"
      },
      {
        "from": "cleanup_start",
        "to": "close"
      },
      {
        "from": "close",
        "to": "cleanup_end"
      }
    ],
    "outputs": [],
    "entry_mode": "async",
    "entries": {
      "stream": {
        "start": "start"
      },
      "cleanup": {
        "start": "cleanup_start"
      }
    },
    "default_entry": "stream"
  }
}
