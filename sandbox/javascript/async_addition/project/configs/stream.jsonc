{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/addition/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "nodeset_imports": [
    {
      "path": "nodeset_types/port_body.jsonc"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "app_session",
        "type": "app.session",
        "display_name": "Application session",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "addition.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "loop",
        "description": "loop",
        "requires": [
          {
            "type": "app.session",
            "cardinality": "exactly_one",
            "display_name": "Application session"
          }
        ],
        "provides": [],
        "loop": {
          "body": "addition.port_body",
          "max_iterations": null,
          "carry": [
            {
              "from": "app.session",
              "as": "app.session",
              "update": "app.session"
            }
          ]
        }
      },
      {
        "id": "open",
        "definition_id": "addition.session.open",
        "display_name": "open",
        "description": "Open the author-owned port API"
      },
      {
        "id": "cleanup_start",
        "definition_id": "addition.boundary",
        "display_name": "cleanup_start",
        "description": "Cleanup entry"
      },
      {
        "id": "close",
        "definition_id": "addition.session.close",
        "display_name": "close",
        "description": "Close the author-owned port API"
      },
      {
        "id": "cleanup_end",
        "definition_id": "addition.boundary",
        "display_name": "cleanup_end",
        "description": "Cleanup completed",
        "similar_to": {
          "node": "cleanup_start",
          "relationship": "copy",
          "reason": "Empty terminal boundary"
        }
      },
      {
        "id": "start_application",
        "definition_id": "app.input.stream_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      },
      {
        "id": "cleanup_start_application",
        "definition_id": "app.input.stream_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      }
    ],
    "edges": [
      {
        "from": "start_application",
        "to": "open"
      },
      {
        "from": "open",
        "to": "loop"
      },
      {
        "from": "cleanup_start_application",
        "to": "close"
      },
      {
        "from": "close",
        "to": "cleanup_end"
      },
      [
        "start",
        "start_application"
      ],
      {
        "from": "start_application",
        "to": "loop",
        "schedule": false,
        "transfer": true
      },
      [
        "cleanup_start",
        "cleanup_start_application"
      ]
    ],
    "outputs": [],
    "entry_mode": "async",
    "entries": {
      "stream": {
        "start": "start"
      },
      "cleanup": {
        "start": "cleanup_start"
      }
    },
    "default_entry": "stream"
  }
}
