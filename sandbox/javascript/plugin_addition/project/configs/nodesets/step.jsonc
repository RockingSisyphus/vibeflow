{
  "type_key": "addition.step",
  "display_name": "Addition step",
  "description": "One addition in a reusable Nodeset",
  "requires": [
    {
      "type": "addition.a",
      "cardinality": "exactly_one",
      "display_name": "addition.a"
    }
  ],
  "provides": [
    {
      "key": "result",
      "type": "addition.result",
      "display_name": "result"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "addition.a",
        "type": "addition.a",
        "display_name": "addition.a",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "addition.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "add",
        "type_used": "addition.add",
        "display_name": "add",
        "description": "add"
      },
      {
        "id": "end",
        "type_used": "addition.boundary",
        "display_name": "end",
        "description": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "add"
      },
      {
        "from": "add",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "addition.result",
        "cardinality": "exactly_one",
        "display_name": "addition.result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
