{
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "name",
        "type": "name.text",
        "display_name": "Name",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "greet",
        "definition_id": "example.greet",
        "display_name": "Build greeting",
        "description": "Formats a greeting with an injected clock.",
        "config": {
          "prefix": "Hello"
        }
      }
    ],
    "edges": [],
    "outputs": [
      {
        "type": "greeting.text",
        "cardinality": "exactly_one",
        "display_name": "Greeting",
        "as": "greeting"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
