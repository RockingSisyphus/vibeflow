{
  "type_key": "sandbox.affine_outer",
  "display_name": "Outer affine nodeset",
  "description": "Runs sibling affine nodeset_types to prove qualified overrides do not leak.",
  "requires": [
    {
      "type": "sandbox.number",
      "cardinality": "exactly_one",
      "display_name": "Number"
    }
  ],
  "provides": [
    {
      "key": "joined_result",
      "type": "sandbox.override.joined",
      "display_name": "Overridden result"
    },
    {
      "key": "default_result",
      "type": "sandbox.override.default",
      "display_name": "Default result"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Outer start",
        "description": "Starts the outer wrapper block."
      },
      {
        "id": "inner",
        "definition_id": "sandbox.affine_inner",
        "display_name": "Call overridden transform",
        "description": "Calls the sibling whose qualified math node is overridden."
      },
      {
        "id": "sibling",
        "definition_id": "sandbox.affine_inner_default",
        "display_name": "Call default transform",
        "description": "Calls the sibling whose math node must retain descriptor defaults."
      },
      {
        "id": "join",
        "definition_id": "sandbox.override_join",
        "display_name": "Join sibling results",
        "description": "Waits for both sibling paths before exposing the overridden result.",
        "join_policy": "all"
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "Outer end",
        "description": "Ends the outer wrapper block."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "inner"
      },
      {
        "from": "start",
        "to": "sibling"
      },
      {
        "from": "inner",
        "to": "join"
      },
      {
        "from": "sibling",
        "to": "join"
      },
      {
        "from": "join",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.override.joined",
        "cardinality": "exactly_one",
        "display_name": "Overridden result",
        "as": "joined_result"
      },
      {
        "type": "sandbox.override.default",
        "cardinality": "exactly_one",
        "display_name": "Default result",
        "as": "default_result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
