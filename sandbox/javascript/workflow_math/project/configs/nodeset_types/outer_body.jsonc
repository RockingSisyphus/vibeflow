{
  "type_key": "sandbox.outer_body",
  "display_name": "Loop body",
  "description": "Three +1 additions per outer iteration",
  "requires": [
    {
      "type": "sandbox.loop.value",
      "cardinality": "exactly_one",
      "display_name": "Loop value"
    }
  ],
  "provides": [
    {
      "key": "next",
      "type": "sandbox.loop.next",
      "display_name": "Next value"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "sandbox.loop.value",
        "type": "sandbox.loop.value",
        "display_name": "Loop value",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Loop body start",
        "description": "Starts one loop iteration."
      },
      {
        "id": "inner",
        "definition_id": "vibeflow.loop.while",
        "display_name": "Increment three times",
        "description": "Carries x through three bounded +1 iterations.",
        "requires": [
          {
            "type": "sandbox.loop.value",
            "cardinality": "exactly_one",
            "display_name": "Loop value"
          }
        ],
        "provides": [
          {
            "key": "next",
            "type": "sandbox.loop.next",
            "display_name": "Next"
          }
        ],
        "loop": {
          "body": "sandbox.loop_body",
          "max_iterations": 3,
          "stop_after": 3,
          "carry": [
            {
              "from": "sandbox.loop.value",
              "as": "sandbox.loop.value",
              "update": "next"
            }
          ],
          "outputs": [
            {
              "from": "next",
              "as": "next"
            }
          ]
        }
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "Loop body end",
        "description": "Ends one loop iteration."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "inner"
      },
      {
        "from": "inner",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.loop.next",
        "cardinality": "exactly_one",
        "display_name": "Next value",
        "as": "next"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
