{
  "nodeset_imports": [
    {
      "path": "nodeset_types/loop_body.jsonc"
    },
    {
      "path": "nodeset_types/outer_body.jsonc"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.loop.value",
        "display_name": "Loop value",
        "required": true
      }
    ],
    "max_steps": 20,
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the bounded loop workflow."
      },
      {
        "id": "loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "Increment three times",
        "description": "Carries x through three bounded +1 iterations.",
        "requires": [
          {
            "type": "sandbox.loop.value",
            "cardinality": "exactly_one",
            "display_name": "Loop value"
          }
        ],
        "provides": [
          {
            "key": "result",
            "type": "sandbox.loop.result",
            "display_name": "Loop result"
          },
          {
            "key": "iterations",
            "type": "sandbox.loop.iterations",
            "display_name": "Iterations"
          }
        ],
        "loop": {
          "body": "sandbox.outer_body",
          "max_iterations": 2,
          "stop_after": 2,
          "carry": [
            {
              "from": "sandbox.loop.value",
              "as": "sandbox.loop.value",
              "update": "next"
            }
          ],
          "outputs": [
            {
              "from": "next",
              "as": "result"
            },
            {
              "from": "loop.iterations",
              "as": "iterations"
            }
          ]
        }
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the bounded loop completes."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "loop"
      },
      {
        "from": "loop",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.loop.result",
        "cardinality": "exactly_one",
        "display_name": "Loop result",
        "as": "result"
      },
      {
        "type": "sandbox.loop.iterations",
        "cardinality": "exactly_one",
        "display_name": "Iterations",
        "as": "iterations"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
