{
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts a main calculation and detached audit task."
      },
      {
        "id": "audit",
        "type_used": "task.launch.sandbox_detached_audit.background",
        "display_name": "任务管理：Audit asynchronously",
        "description": "Starts an explicitly declared workflow-owned task.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "sandbox.detached_audit",
            "display_name": "Audit asynchronously",
            "description": "Runs independently but is cleaned up before the call returns.",
            "config": {
              "label": "detached-complete"
            }
          }
        }
      },
      {
        "id": "calculate",
        "type_used": "sandbox.math",
        "display_name": "Preserve input",
        "description": "Keeps a synchronous business result on the main path.",
        "config": {
          "scale": 1,
          "offset": 0
        }
      },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the main calculation is available."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "audit"
      },
      {
        "from": "start",
        "to": "calculate"
      },
      {
        "from": "calculate",
        "to": "end"
      },
      {
        "from": "audit",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
