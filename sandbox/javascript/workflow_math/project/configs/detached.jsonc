{
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      },
      {
        "key": "app_session",
        "type": "app.session",
        "display_name": "Application session",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts a main calculation and detached audit task."
      },
      {
        "id": "audit",
        "definition_id": "sandbox.detached_audit",
        "display_name": "audit",
        "description": "Executes the declared ordinary workflow node.",
        "config": {
          "label": "detached-complete"
        }
      },
      {
        "id": "calculate",
        "definition_id": "sandbox.math",
        "display_name": "Preserve input",
        "description": "Keeps a synchronous business result on the main path.",
        "config": {
          "scale": 1,
          "offset": 0
        }
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the main calculation is available."
      },
      {
        "id": "start_application",
        "definition_id": "app.input.detached_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      }
    ],
    "edges": [
      {
        "from": "start_application",
        "to": "audit"
      },
      {
        "from": "start_application",
        "to": "calculate"
      },
      {
        "from": "calculate",
        "to": "end"
      },
      {
        "from": "audit",
        "to": "end"
      },
      [
        "start",
        "start_application"
      ]
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
