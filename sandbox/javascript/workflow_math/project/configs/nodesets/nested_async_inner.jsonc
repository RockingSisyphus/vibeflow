{
  "type_key": "sandbox.nested_async_inner",
  "display_name": "Nested async inner block",
  "description": "Combines one deferred calculation with one detached audit task.",
  "requires": [
    {
      "type": "sandbox.number",
      "cardinality": "exactly_one",
      "display_name": "Number"
    }
  ],
  "provides": [
    {
      "key": "doubled",
      "type": "sandbox.async.value",
      "display_name": "Doubled value"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Inner start",
        "description": "Starts both nested tasks."
      },
      {
        "id": "double",
        "type_used": "task.launch.sandbox_async_double.waited",
        "display_name": "任务管理：Deferred double",
        "description": "Starts an explicitly declared workflow-owned task.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "sandbox.async_double",
            "display_name": "Deferred double",
            "description": "Resolves the nested business result."
          }
        }
      },
      {
        "id": "double_join",
        "type_used": "task.join.sandbox_async_double",
        "display_name": "任务管理：等待 Deferred double",
        "description": "Waits for actual task execution and cleanup, then returns its declared outputs."
      },
      {
        "id": "audit",
        "type_used": "task.launch.sandbox_detached_audit.background",
        "display_name": "任务管理：Detached nested audit",
        "description": "Starts an explicitly declared workflow-owned task.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "sandbox.detached_audit",
            "display_name": "Detached nested audit",
            "description": "Exercises invocation-owned detached cleanup.",
            "config": {
              "label": "nested-async"
            }
          }
        }
      },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "Inner end",
        "description": "Ends after the deferred result is joined."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "double"
      },
      {
        "from": "start",
        "to": "audit"
      },
      {
        "from": "double_join",
        "to": "end"
      },
      {
        "from": "double",
        "to": "double_join"
      },
      {
        "from": "audit",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.async.value",
        "cardinality": "exactly_one",
        "display_name": "Doubled value",
        "as": "doubled"
      }
    ],
    "entry_mode": "async"
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
