{
  "rulesets": [],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.x",
        "display_name": "X",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts both the data source and control-delay branches."
      },
      {
        "id": "seed",
        "definition_id": "sandbox.fanout_add",
        "display_name": "Seed payload",
        "description": "Adds one to x and transfers the result without scheduling the consumer."
      },
      {
        "id": "delay",
        "definition_id": "sandbox.terminal",
        "display_name": "Control delay",
        "description": "Keeps the consumer off the schedule until the poison node runs."
      },
      {
        "id": "poison",
        "definition_id": "sandbox.edge_poison",
        "display_name": "Produce sentinel",
        "description": "Produces a same-typed sentinel that must not reach the consumer.",
        "value": 999
      },
      {
        "id": "consume",
        "definition_id": "sandbox.edge_consume",
        "display_name": "Consume transferred payload",
        "description": "Runs only after poison schedules it, then doubles the seed payload."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the consumer result is available."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "seed"
      },
      {
        "from": "start",
        "to": "delay"
      },
      {
        "from": "seed",
        "to": "consume",
        "schedule": false
      },
      {
        "from": "delay",
        "to": "poison"
      },
      {
        "from": "poison",
        "to": "consume",
        "transfer": false
      },
      {
        "from": "consume",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
