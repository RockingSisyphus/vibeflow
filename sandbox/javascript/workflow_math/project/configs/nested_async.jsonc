{
  "nodeset_imports": [
    {
      "path": "nodeset_types/nested_async_inner.jsonc"
    },
    {
      "path": "nodeset_types/nested_async_outer.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the nested async workflow."
      },
      {
        "id": "outer",
        "definition_id": "sandbox.nested_async_outer",
        "display_name": "Run nested async blocks",
        "description": "Runs the two-level deferred and detached test graph."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the nested result is available."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "outer"
      },
      {
        "from": "outer",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.async.value",
        "cardinality": "exactly_one",
        "display_name": "Doubled value",
        "as": "doubled"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
