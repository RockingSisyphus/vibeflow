{
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      },
      {
        "key": "key",
        "type": "sandbox.storage.key",
        "display_name": "Storage key",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the async and Capability workflow."
      },
      {
        "id": "double",
        "type_used": "task.launch.sandbox_async_double.waited",
        "display_name": "任务管理：Double asynchronously",
        "description": "Starts an explicitly declared workflow-owned task.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "sandbox.async_double",
            "display_name": "Double asynchronously",
            "description": "Doubles x through a Promise-returning node."
          }
        }
      },
      {
        "id": "double_join",
        "type_used": "task.join.sandbox_async_double",
        "display_name": "任务管理：等待 Double asynchronously",
        "description": "Waits for actual task execution and cleanup, then returns its declared outputs."
      },
      {
        "id": "read",
        "type_used": "sandbox.storage_read",
        "display_name": "Read storage",
        "description": "Reads from the per-run injected storage Capability."
      },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the asynchronous and Capability results are available.",
        "join_policy": "all"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "double"
      },
      {
        "from": "start",
        "to": "read"
      },
      {
        "from": "double_join",
        "to": "end"
      },
      {
        "from": "read",
        "to": "end"
      },
      {
        "from": "double",
        "to": "double_join"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.async.value",
        "cardinality": "exactly_one",
        "display_name": "Doubled value",
        "as": "doubled"
      },
      {
        "type": "sandbox.storage.value",
        "cardinality": "exactly_one",
        "display_name": "Stored value",
        "as": "value"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
