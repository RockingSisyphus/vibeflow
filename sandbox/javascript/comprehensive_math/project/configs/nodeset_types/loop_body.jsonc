      "cardinality": "exactly_one",
      "display_name": "math.value"
    },
    {
      "type": "math.counter",
      "cardinality": "exactly_one",
      "display_name": "math.counter"
    }
  ],
  "provides": [
    {
      "key": "next",
      "type": "math.next",
      "display_name": "next"
    },
    {
      "key": "counter",
      "type": "math.next_counter",
      "display_name": "counter"
    },
    {
      "key": "done",
      "type": "math.done",
      "display_name": "done"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "math.value",
        "type": "math.value",
        "display_name": "math.value",
        "required": true
      },
      {
        "key": "math.counter",
        "type": "math.counter",
        "display_name": "math.counter",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "math.boundary",
        "display_name": "start",
        "description": "start"
      },
      {
        "id": "step",
        "definition_id": "math.step",
        "display_name": "step",
        "description": "step"
      },
      {
        "id": "end",
        "definition_id": "math.boundary",
        "display_name": "end",
        "description": "end"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "step"
      },
      {
        "from": "step",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "math.next",
        "cardinality": "exactly_one",
        "display_name": "math.next",
        "as": "next"
      },
      {
        "type": "math.next_counter",
        "cardinality": "exactly_one",
        "display_name": "math.next_counter",
        "as": "counter"
      },
      {
        "type": "math.done",
        "cardinality": "exactly_one",
        "display_name": "math.done",
        "as": "done"
      }
    ]
  },
  "plugins": [
    {
