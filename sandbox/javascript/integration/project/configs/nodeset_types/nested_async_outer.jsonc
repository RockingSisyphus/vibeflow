{
  "type_key": "sandbox.nested_async_outer",
  "display_name": "Nested async outer block",
  "description": "Wraps the async inner block to verify deep task paths.",
  "requires": [
    {
      "type": "sandbox.number",
      "cardinality": "exactly_one",
      "display_name": "Number"
    },
    {
      "type": "app.session",
      "cardinality": "exactly_one",
      "display_name": "Application session"
    }
  ],
  "provides": [
    {
      "key": "doubled",
      "type": "sandbox.async.value",
      "display_name": "Doubled value"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      },
      {
        "key": "app.session",
        "type": "app.session",
        "display_name": "Application session",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Outer start",
        "description": "Starts the outer nested block."
      },
      {
        "id": "inner",
        "definition_id": "sandbox.nested_async_inner",
        "display_name": "Run async inner block",
        "description": "Runs deferred and detached work one level deeper."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "Outer end",
        "description": "Ends after the inner result is available."
      },
      {
        "id": "start_application",
        "definition_id": "app.input.nodeset_types_nested_async_outer_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      }
    ],
    "edges": [
      {
        "from": "start_application",
        "to": "inner"
      },
      {
        "from": "inner",
        "to": "end"
      },
      [
        "start",
        "start_application"
      ]
    ],
    "outputs": [
      {
        "type": "sandbox.async.value",
        "cardinality": "exactly_one",
        "display_name": "Doubled value",
        "as": "doubled"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
