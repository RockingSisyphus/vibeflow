{
  "type_key": "sandbox.permanent_port_body",
  "display_name": "Permanent Port iteration",
  "description": "Receives one value, applies TypeScript math, and sends the result.",
  "requires": [
    {
      "type": "app.session",
      "cardinality": "exactly_one",
      "display_name": "Application session"
    }
  ],
  "provides": [],
  "pipeline": {
    "entry_mode": "async",
    "nodes": [
      {
        "id": "receive_start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Explicit entry before receiving a host value."
      },
      {
        "id": "receive",
        "definition_id": "sandbox.port_receive_0",
        "display_name": "Receive number",
        "description": "Waits for the next number from the sandbox Port.",
        "config": {
          "port": "sandbox.permanent.in"
        }
      },
      {
        "id": "calculate",
        "definition_id": "sandbox.math",
        "display_name": "Calculate result",
        "description": "Applies x * 3 + 2 through the TypeScript math base_lib.",
        "config": {
          "scale": 3,
          "offset": 2
        }
      },
      {
        "id": "send",
        "definition_id": "sandbox.port_send_1",
        "display_name": "Send result",
        "description": "Submits the calculated result to the sandbox Port.",
        "config": {
          "port": "sandbox.permanent.out"
        }
      },
      {
        "id": "send_end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Explicit end after sending a host value."
      },
      {
        "id": "receive_start_application",
        "definition_id": "app.input.nodeset_types_permanent_port_body_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      }
    ],
    "edges": [
      [
        "receive_start_application",
        "receive"
      ],
      {
        "from": "receive",
        "to": "calculate"
      },
      {
        "from": "calculate",
        "to": "send"
      },
      [
        "send",
        "send_end"
      ],
      [
        "receive_start",
        "receive_start_application"
      ],
      {
        "from": "receive_start_application",
        "to": "send",
        "schedule": false,
        "transfer": true
      }
    ],
    "outputs": [],
    "inputs": [
      {
        "key": "app.session",
        "type": "app.session",
        "display_name": "Application session",
        "required": true
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
