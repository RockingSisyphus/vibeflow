{
  "host_extensions": [
    {
      "id": "sandbox.math_host",
      "status": "implemented",
      "config": {"channel": "sandbox"}
    },
    {
      "id": "sandbox.future_host",
      "status": "planned",
      "display_name": "Future Sandbox Host",
      "description": "Represents a future host connection for architecture review.",
      "category": "host",
      "version": "0.1.0",
      "targets": ["node"],
      "provides": ["sandbox.future_port"],
      "dependencies": []
    }
  ],
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the Host Extension fixture."
      },
      {
        "id": "double",
        "type_used": "sandbox.host_double",
        "display_name": "Host double",
        "description": "Calls the Capability provided by the Host Extension."
              },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends the Host Extension fixture."
      }
    ],
    "edges": [
      ["start", "double"],
      ["double", "end"]
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  }
}
