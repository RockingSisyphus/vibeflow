{
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the controlled node failure workflow."
      },
      {
        "id": "invalid",
        "definition_id": "sandbox.runtime_failure",
        "display_name": "Throw node error",
        "description": "Throws a controlled Error from a valid TypeScript node.",
        "config": {
          "mode": "throw"
        }
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Must not run after the controlled node failure."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "invalid"
      },
      {
        "from": "invalid",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
