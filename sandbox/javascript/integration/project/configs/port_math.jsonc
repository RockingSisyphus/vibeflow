{
  "pipeline": {
    "entry_mode": "async",
    "nodes": [
      {
        "id": "receive_start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Explicit entry before receiving a host value."
      },
      {
        "id": "receive",
        "type_used": "sandbox.port_receive_0",
        "display_name": "Receive number",
        "description": "Waits for one number from the fake sandbox host.",
        "config": {
          "port": "sandbox.math.in"
        }
      },
      {
        "id": "calculate",
        "type_used": "sandbox.math",
        "display_name": "Affine calculation",
        "description": "Combines a TS node and TS base_lib into x * 3 + 2.",
        "config": {
          "scale": 3,
          "offset": 2
        }
      },
      {
        "id": "send",
        "type_used": "sandbox.port_send_1",
        "display_name": "Send result",
        "description": "Submits the calculated value to the fake sandbox host.",
        "config": {
          "port": "sandbox.math.out"
        }
      },
      {
        "id": "send_end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Explicit end after sending a host value."
      }
    ],
    "edges": [
      [
        "receive_start",
        "receive"
      ],
      {
        "from": "receive",
        "to": "calculate"
      },
      {
        "from": "calculate",
        "to": "send"
      },
      [
        "send",
        "send_end"
      ]
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Calculated result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
