{
  "pipeline": {
    "entry_mode": "async",
    "nodes": [
      {
        "id": "receive_start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Explicit entry before receiving a host value."
      },
      {
        "id": "receive",
        "definition_id": "sandbox.port_receive_0",
        "display_name": "Receive number",
        "description": "Waits for one number from the fake sandbox host.",
        "config": {
          "port": "sandbox.math.in"
        }
      },
      {
        "id": "calculate",
        "definition_id": "sandbox.math",
        "display_name": "Affine calculation",
        "description": "Combines a TS node and TS base_lib into x * 3 + 2.",
        "config": {
          "scale": 3,
          "offset": 2
        }
      },
      {
        "id": "send",
        "definition_id": "sandbox.port_send_1",
        "display_name": "Send result",
        "description": "Submits the calculated value to the fake sandbox host.",
        "config": {
          "port": "sandbox.math.out"
        }
      },
      {
        "id": "send_end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Explicit end after sending a host value."
      },
      {
        "id": "receive_start_application",
        "definition_id": "app.input.port_math_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      }
    ],
    "edges": [
      [
        "receive_start_application",
        "receive"
      ],
      {
        "from": "receive",
        "to": "calculate"
      },
      {
        "from": "calculate",
        "to": "send"
      },
      [
        "send",
        "send_end"
      ],
      [
        "receive_start",
        "receive_start_application"
      ],
      {
        "from": "receive_start_application",
        "to": "send",
        "schedule": false,
        "transfer": true
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Calculated result",
        "as": "result"
      }
    ],
    "inputs": [
      {
        "key": "app_session",
        "type": "app.session",
        "display_name": "Application session",
        "required": true
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
