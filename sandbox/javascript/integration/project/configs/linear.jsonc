{
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.x",
        "display_name": "X",
        "required": true
      },
      {
        "key": "a",
        "type": "sandbox.addend",
        "display_name": "Addend",
        "required": true
      },
      {
        "key": "b",
        "type": "sandbox.subtrahend",
        "display_name": "Subtrahend",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the linear arithmetic workflow."
      },
      {
        "id": "add",
        "type_used": "sandbox.add",
        "display_name": "Add x and a",
        "description": "Computes x + a through the registered math base_lib."
              },
      {
        "id": "subtract",
        "type_used": "sandbox.subtract",
        "display_name": "Subtract b",
        "description": "Computes (x + a) - b through the registered math base_lib."
              },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the arithmetic result is available."
      }
    ],
    "edges": [
      {"from": "start", "to": "add"},
      {"from": "add", "to": "subtract"},
      {"from": "subtract", "to": "end"}
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  }
}
