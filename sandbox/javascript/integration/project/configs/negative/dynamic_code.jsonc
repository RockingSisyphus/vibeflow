{
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the isolated dynamic_code fixture."
      },
      {
        "id": "invalid",
        "type_used": "sandbox.invalid.dynamic_code",
        "display_name": "dynamic code",
        "description": "B06 allows runtime string evaluation; this fixture must build and run."
      },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends the isolated dynamic_code fixture."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "invalid"
      },
      {
        "from": "invalid",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
