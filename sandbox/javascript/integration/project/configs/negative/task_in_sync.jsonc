{
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the invalid sync ordinary Node fixture."
      },
      {
        "id": "invalid",
        "definition_id": "sandbox.async_double",
        "display_name": "invalid",
        "description": "Executes the declared ordinary workflow node."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Would end the invalid fixture."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "invalid"
      },
      {
        "from": "invalid",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.async.value",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
