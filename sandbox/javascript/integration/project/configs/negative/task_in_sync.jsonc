{
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the invalid sync TaskPlan fixture."
      },
      {
        "id": "invalid",
        "type_used": "sandbox.math",
        "display_name": "Deferred node in sync workflow",
        "description": "Must fail because a sync entry cannot contain a deferred TaskPlan.",
        "async": "result_key",
        "result_key": "result"
              },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Would end the invalid fixture."
      }
    ],
    "edges": [
      {"from": "start", "to": "invalid"},
      {"from": "invalid", "to": "end"}
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  }
}
