{
  "pipeline": {
    "entry_mode": "sync",
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the invalid sync TaskPlan fixture."
      },
      {
        "id": "invalid",
        "type_used": "task.launch.sandbox_async_double.waited",
        "display_name": "Task manager in sync",
        "description": "Cannot launch workflow tasks from a synchronous JS workflow.",
        "task_targets": {
          "work": {
            "id": "work",
            "type_used": "sandbox.math",
            "display_name": "Deferred node in sync workflow",
            "description": "Must fail because a sync entry cannot contain a deferred TaskPlan."
          }
        }
      },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Would end the invalid fixture."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "invalid"
      },
      {
        "from": "invalid",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "code_plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
