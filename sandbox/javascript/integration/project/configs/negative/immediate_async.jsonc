{
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the completion mismatch fixture."
      },
      {
        "id": "invalid",
        "type_used": "sandbox.invalid.immediate_async",
        "display_name": "Immediate async mismatch",
        "description": "Must fail because an immediate node cannot return a Promise."
              },
      {
        "id": "end",
        "type_used": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends the completion mismatch fixture."
      }
    ],
    "edges": [
      {"from": "start", "to": "invalid"},
      {"from": "invalid", "to": "end"}
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  }
}
