{
  "plugins": [
    {
      "id": "sandbox.policy_audit",
      "config": {"expectedNodes": 4}
    },
    "sandbox.compiler_audit",
    {
      "id": "sandbox.runtime_audit",
      "config": {"expectedNodes": 4}
    },
    {
      "id": "sandbox.future_runtime",
      "status": "planned",
      "type": "runtime",
      "targets": ["node"],
      "config": {"purpose": "architecture-only"}
    }
  ],
  "pipeline": {
    "inputs": [
      {"key": "x", "type": "sandbox.x", "display_name": "X", "required": true},
      {"key": "a", "type": "sandbox.addend", "display_name": "Addend", "required": true},
      {"key": "b", "type": "sandbox.subtrahend", "display_name": "Subtrahend", "required": true}
    ],
    "nodes": [
      {"id": "start", "type_used": "sandbox.terminal", "display_name": "Start"},
      {
        "id": "add",
        "type_used": "sandbox.add",
        "display_name": "Add",
        "requires": [
          {"type": "sandbox.x", "cardinality": "exactly_one", "display_name": "X"},
          {"type": "sandbox.addend", "cardinality": "exactly_one", "display_name": "Addend"},
          {"type": "sandbox.subtrahend", "cardinality": "exactly_one", "display_name": "Subtrahend"}
        ],
        "provides": [
          {"key": "sum", "type": "sandbox.sum", "display_name": "Sum"},
          {
            "key": "forwarded_subtrahend",
            "type": "sandbox.subtrahend.forwarded",
            "display_name": "Forwarded subtrahend"
          }
        ]
      },
      {
        "id": "subtract",
        "type_used": "sandbox.subtract",
        "display_name": "Subtract",
        "requires": [
          {"type": "sandbox.sum", "cardinality": "exactly_one", "display_name": "Sum"},
          {
            "type": "sandbox.subtrahend.forwarded",
            "cardinality": "exactly_one",
            "display_name": "Forwarded subtrahend"
          }
        ],
        "provides": [
          {"key": "result", "type": "sandbox.math.result", "display_name": "Result"}
        ]
      },
      {"id": "end", "type_used": "sandbox.terminal", "display_name": "End"}
    ],
    "edges": [
      {"from": "start", "to": "add"},
      {"from": "add", "to": "subtract"},
      {"from": "subtract", "to": "end"}
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  }
}
