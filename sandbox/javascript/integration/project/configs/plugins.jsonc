{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/compiler_audit/plugin.ts",
        "export": "plugin"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugins/runtime_audit/plugin.ts",
        "export": "plugin"
      },
      "config": {
        "expectedNodes": 4
      }
    },
    {
      "id": "sandbox.future_runtime",
      "status": "planned",
      "type": "runtime",
      "targets": [
        "node"
      ],
      "config": {
        "purpose": "architecture-only"
      }
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.x",
        "display_name": "X",
        "required": true
      },
      {
        "key": "a",
        "type": "sandbox.addend",
        "display_name": "Addend",
        "required": true
      },
      {
        "key": "b",
        "type": "sandbox.subtrahend",
        "display_name": "Subtrahend",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the plugin integration workflow."
      },
      {
        "id": "add",
        "definition_id": "sandbox.add",
        "display_name": "Add",
        "description": "Adds the configured input value in this workflow instance."
      },
      {
        "id": "subtract",
        "definition_id": "sandbox.subtract",
        "display_name": "Subtract",
        "description": "Subtracts the configured input value in this workflow instance."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends the plugin integration workflow."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "add"
      },
      {
        "from": "add",
        "to": "subtract"
      },
      {
        "from": "subtract",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
