{
  "nodeset_imports": [
    {
      "path": "nodeset_types/arithmetic.jsonc"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.x",
        "display_name": "X",
        "required": true
      },
      {
        "key": "a",
        "type": "sandbox.addend",
        "display_name": "Addend",
        "required": true
      },
      {
        "key": "b",
        "type": "sandbox.subtrahend",
        "display_name": "Subtrahend",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the reusable arithmetic nodeset workflow."
      },
      {
        "id": "arithmetic",
        "definition_id": "sandbox.arithmetic_nodeset",
        "display_name": "Run arithmetic nodeset",
        "description": "Computes (x + a) - b inside a nested block."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the nodeset result is available."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "arithmetic"
      },
      {
        "from": "arithmetic",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
