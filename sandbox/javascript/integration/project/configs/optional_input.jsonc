{
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.x",
        "display_name": "X",
        "required": true
      },
      {
        "key": "offset",
        "type": "sandbox.optional.offset",
        "display_name": "Optional offset",
        "required": false
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the optional pipeline input fixture."
      },
      {
        "id": "add",
        "definition_id": "sandbox.optional_add",
        "display_name": "Add optional offset",
        "description": "Adds offset when supplied and otherwise adds zero."
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the optional arithmetic result is available."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "add"
      },
      {
        "from": "add",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.math.result",
        "cardinality": "exactly_one",
        "display_name": "Result",
        "as": "result"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
