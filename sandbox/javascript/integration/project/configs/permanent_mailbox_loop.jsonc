{
  "nodeset_imports": [
    {
      "path": "nodeset_types/permanent_port_body.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start permanent workflow",
        "description": "Starts the asynchronous permanent Port workflow."
      },
      {
        "id": "loop",
        "definition_id": "vibeflow.loop.while",
        "display_name": "Permanent Port loop",
        "description": "Processes Port values until the host aborts this invocation.",
        "loop": {
          "body": "sandbox.permanent_port_body",
          "max_iterations": null,
          "carry": [
            {
              "from": "app.session",
              "as": "app.session",
              "update": "app.session"
            }
          ]
        },
        "requires": [
          {
            "type": "app.session",
            "cardinality": "exactly_one",
            "display_name": "Application session"
          }
        ],
        "provides": []
      },
      {
        "id": "start_application",
        "definition_id": "app.input.permanent_mailbox_loop_jsonc",
        "display_name": "Application input",
        "description": "Supplies the application instance to this entry."
      }
    ],
    "edges": [
      {
        "from": "start_application",
        "to": "loop"
      },
      [
        "start",
        "start_application"
      ]
    ],
    "outputs": [],
    "inputs": [
      {
        "key": "app_session",
        "type": "app.session",
        "display_name": "Application session",
        "required": true
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ],
  "base_lib": {
    "modules": [
      "sandbox.math"
    ]
  }
}
