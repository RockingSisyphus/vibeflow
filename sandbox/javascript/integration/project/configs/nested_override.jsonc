{
  "nodeset_imports": [
    {
      "path": "nodeset_types/affine_inner.jsonc"
    },
    {
      "path": "nodeset_types/affine_inner_default.jsonc"
    },
    {
      "path": "nodeset_types/affine_outer.jsonc"
    }
  ],
  "pipeline": {
    "inputs": [
      {
        "key": "x",
        "type": "sandbox.number",
        "display_name": "Number",
        "required": true
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "sandbox.terminal",
        "display_name": "Start",
        "description": "Starts the nested override workflow."
      },
      {
        "id": "outer",
        "definition_id": "sandbox.affine_outer",
        "display_name": "Run nested transform",
        "description": "Overrides only the qualified inner math node.",
        "node_configs": {
          "inner.math": {
            "scale": 3,
            "offset": 4
          }
        }
      },
      {
        "id": "end",
        "definition_id": "sandbox.terminal",
        "display_name": "End",
        "description": "Ends after the nested transform."
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "outer"
      },
      {
        "from": "outer",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "sandbox.override.joined",
        "cardinality": "exactly_one",
        "display_name": "Overridden result",
        "as": "result"
      },
      {
        "type": "sandbox.override.default",
        "cardinality": "exactly_one",
        "display_name": "Default result",
        "as": "defaultResult"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
