{
  "kind": "plugin",
  "id": "sandbox.runtime_audit",
  "type": "runtime",
  "targets": ["browser", "node"],
  "priority": 30,
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "completion": "immediate",
      "source": {
        "kind": "file",
        "ref": "plugins/runtime_audit.ts",
        "export": "createPlugin"
      }
    }
  ],
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "expectedNodes": {"type": "integer", "minimum": 1}
      },
      "required": ["expectedNodes"],
      "additionalProperties": false
    },
    "defaults": {"expectedNodes": 4}
  }
}
