{
  "kind": "node",
  "type_key": "sandbox.subtract",
  "display_name": "Subtract",
  "category": "sandbox",
  "description": "Subtracts b from an incoming sum through the registered TypeScript base_lib.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.sum",
        "cardinality": "exactly_one",
        "display_name": "Sum"
      },
      {
        "type": "sandbox.subtrahend.forwarded",
        "cardinality": "exactly_one",
        "display_name": "Forwarded subtrahend"
      }
    ],
    "provides": [
      {
        "key": "result",
        "type": "sandbox.math.result",
        "display_name": "Result"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.sum": [
        "Sum input consumed by this node."
      ],
      "sandbox.subtrahend.forwarded": [
        "Forwarded subtrahend input consumed by this node."
      ]
    },
    "output_semantics": {
      "result": [
        "Result output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/subtract.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "sandbox.math"
  ],
  "capabilities": []
}
