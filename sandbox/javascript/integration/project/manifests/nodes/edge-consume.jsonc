        "display_name": "Result"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.fanout.added": [
        "Transferred payload input consumed by this node."
      ]
    },
    "output_semantics": {
      "result": [
        "Result output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
