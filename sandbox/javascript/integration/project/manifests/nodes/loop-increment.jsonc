{
  "kind": "node",
  "type_key": "sandbox.loop_increment",
  "display_name": "Loop increment",
  "category": "sandbox",
  "description": "Adds one to the current loop carry value.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.loop.value",
        "cardinality": "exactly_one",
        "display_name": "Loop value"
      }
    ],
    "provides": [
      {
        "key": "next",
        "type": "sandbox.loop.next",
        "display_name": "Next value"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.loop.value": [
        "Loop value input consumed by this node."
      ]
    },
    "output_semantics": {
      "next": [
        "Next value output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/loop_increment.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "sandbox.math"
  ],
  "capabilities": []
}
