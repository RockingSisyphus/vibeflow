{
  "kind": "node",
  "type_key": "sandbox.add",
  "display_name": "Add",
  "category": "sandbox",
  "description": "Adds x and a through the registered TypeScript base_lib.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.x",
        "cardinality": "exactly_one",
        "display_name": "X"
      },
      {
        "type": "sandbox.addend",
        "cardinality": "exactly_one",
        "display_name": "Addend"
      },
      {
        "type": "sandbox.subtrahend",
        "cardinality": "exactly_one",
        "display_name": "Subtrahend"
      }
    ],
    "provides": [
      {
        "key": "sum",
        "type": "sandbox.sum",
        "display_name": "Sum"
      },
      {
        "key": "forwarded_subtrahend",
        "type": "sandbox.subtrahend.forwarded",
        "display_name": "Forwarded subtrahend"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.x": [
        "X input consumed by this node."
      ],
      "sandbox.addend": [
        "Addend input consumed by this node."
      ],
      "sandbox.subtrahend": [
        "Subtrahend input consumed by this node."
      ]
    },
    "output_semantics": {
      "sum": [
        "Sum output produced by this node."
      ],
      "forwarded_subtrahend": [
        "Forwarded subtrahend output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/add.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "sandbox.math"
  ],
  "capabilities": []
}
