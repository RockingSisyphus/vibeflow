{
  "kind": "node",
  "type_key": "sandbox.negative",
  "display_name": "Negative branch",
  "category": "sandbox",
  "description": "Formats the selected negative branch value.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.branch.forwarded",
        "cardinality": "exactly_one",
        "display_name": "Forwarded number"
      }
    ],
    "provides": [
      {
        "key": "negative_message",
        "type": "sandbox.branch.message",
        "display_name": "Negative message"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "output_schema": {
      "negative_message": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": ["browser", "node"],
      "source": {
        "kind": "file",
        "ref": "nodes/negative.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
