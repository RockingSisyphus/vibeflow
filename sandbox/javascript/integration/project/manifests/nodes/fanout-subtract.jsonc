        "type": "sandbox.fanout.subtracted",
        "display_name": "Subtracted branch"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.x": [
        "X input consumed by this node."
      ]
    },
    "output_semantics": {
      "subtracted_branch": [
        "Subtracted branch output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/fanout_subtract.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "sandbox.math"
  ],
  "capabilities": []
}
