{
  "kind": "node",
  "type_key": "sandbox.loop_done",
  "display_name": "Loop done",
  "category": "sandbox",
  "description": "Reports whether the incremented loop value reached the configured target.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.loop.next",
        "cardinality": "exactly_one",
        "display_name": "Next value"
      }
    ],
    "provides": [
      {
        "key": "done",
        "type": "sandbox.loop.done",
        "display_name": "Done"
      }
    ],
    "params_schema": {
      "target": {
        "type": "number"
      }
    },
    "params_defaults": {
      "target": 4
    },
    "input_semantics": {
      "sandbox.loop.next": [
        "Next value input consumed by this node."
      ]
    },
    "output_semantics": {
      "done": [
        "Done output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/loop_done.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
