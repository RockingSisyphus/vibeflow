{
  "kind": "node",
  "type_key": "sandbox.optional_add",
  "display_name": "Optional add",
  "category": "sandbox",
  "description": "Adds an optional offset to x through the registered TypeScript base_lib.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.x",
        "cardinality": "exactly_one",
        "display_name": "X"
      },
      {
        "type": "sandbox.optional.offset",
        "cardinality": "optional_one",
        "display_name": "Optional offset"
      }
    ],
    "provides": [
      {
        "key": "result",
        "type": "sandbox.math.result",
        "display_name": "Result"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.x": [
        "X input consumed by this node."
      ],
      "sandbox.optional.offset": [
        "Optional offset input consumed by this node."
      ]
    },
    "output_semantics": {
      "result": [
        "Result output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/optional_add.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [
    "sandbox.math"
  ],
  "capabilities": []
}
