{
  "kind": "node",
  "type_key": "sandbox.positive",
  "display_name": "Positive branch",
  "category": "sandbox",
  "description": "Formats the selected non-negative branch value.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.branch.forwarded",
        "cardinality": "exactly_one",
        "display_name": "Forwarded number"
      }
    ],
    "provides": [
      {
        "key": "positive_message",
        "type": "sandbox.branch.message",
        "display_name": "Positive message"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.branch.forwarded": [
        "Forwarded number input consumed by this node."
      ]
    },
    "output_semantics": {
      "positive_message": [
        "Positive message output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/positive.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
