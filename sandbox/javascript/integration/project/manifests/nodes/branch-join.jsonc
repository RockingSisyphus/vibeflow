{
  "kind": "node",
  "type_key": "sandbox.branch_join",
  "display_name": "Branch join",
  "category": "sandbox",
  "description": "Consumes the one active branch message.",
  "version": "1.0.0",
  "flow_kind": "process",
  "contract": {
    "requires": [
      {
        "type": "sandbox.branch.message",
        "cardinality": "exactly_one",
        "display_name": "Selected branch message"
      }
    ],
    "provides": [
      {
        "key": "message",
        "type": "sandbox.branch.output",
        "display_name": "Message"
      }
    ],
    "params_schema": {},
    "params_defaults": {},
    "input_semantics": {
      "sandbox.branch.message": [
        "Selected branch message input consumed by this node."
      ]
    },
    "output_semantics": {
      "message": [
        "Message output produced by this node."
      ]
    }
  },
  "implementations": [
    {
      "language": "typescript",
      "targets": [
        "browser",
        "node"
      ],
      "source": {
        "kind": "file",
        "ref": "nodes/branch_join.ts",
        "export": "run"
      }
    }
  ],
  "base_libs": [],
  "capabilities": []
}
