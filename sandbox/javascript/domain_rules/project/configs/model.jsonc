{
  "pipeline": {
    "inputs": [
      {
        "key": "value",
        "type": "example.input",
        "required": true,
        "display_name": "example.input"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "definition_id": "example.boundary",
        "display_name": "Start",
        "description": "Starts the native workflow."
      },
      {
        "id": "model",
        "definition_id": "example.model",
        "display_name": "model",
        "description": "Executes this functional block through native Node contracts."
      },
      {
        "id": "transform",
        "definition_id": "example.transform",
        "display_name": "transform",
        "description": "Executes this functional block through native Node contracts."
      },
      {
        "id": "end",
        "definition_id": "example.boundary",
        "display_name": "End",
        "description": "Ends the native workflow."
      }
    ],
    "edges": [
      {
        "source": "start",
        "target": "model"
      },
      {
        "source": "model",
        "target": "transform"
      },
      {
        "source": "transform",
        "target": "end"
      }
    ],
    "outputs": [
      {
        "type": "example.output",
        "cardinality": "exactly_one",
        "as": "result",
        "display_name": "example.output"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugins/code_plugin/plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
