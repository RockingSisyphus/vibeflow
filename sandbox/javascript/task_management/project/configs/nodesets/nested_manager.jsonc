{
  "type_key": "fixture.manager_block",
  "display_name": "Nested task manager",
  "description": "A managed caller spawns and joins tasks without using a work pool slot",
  "requires": [
    {
      "type": "fixture.scenario",
      "cardinality": "exactly_one",
      "display_name": "Scenario"
    }
  ],
  "provides": [
    {
      "key": "fixture.report",
      "type": "fixture.report",
      "display_name": "Report"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [
      {
        "key": "scenario",
        "type": "fixture.scenario",
        "required": true,
        "display_name": "Scenario"
      }
    ],
    "nodes": [
      {
        "id": "start",
        "type_used": "fixture.terminal",
        "display_name": "start",
        "description": "Task management acceptance call"
      },
      {
        "id": "launch",
        "type_used": "fixture.launch",
        "display_name": "父调用者启动和停止多个并发任务并等待实际清理完成的任务管理节点",
        "description": "Task management acceptance call",
        "task_targets": {
          "worker": {
            "type_used": "fixture.worker"
          }
        }
      },
      {
        "id": "relay",
        "type_used": "fixture.relay",
        "display_name": "relay",
        "description": "Task management acceptance call"
      },
      {
        "id": "control",
        "type_used": "fixture.control",
        "display_name": "control",
        "description": "Task management acceptance call"
      },
      {
        "id": "end",
        "type_used": "fixture.terminal",
        "display_name": "end",
        "description": "Task management acceptance call"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "launch"
      },
      {
        "from": "launch",
        "to": "relay"
      },
      {
        "from": "relay",
        "to": "control"
      },
      {
        "from": "control",
        "to": "end"
      }
    ],
    "outputs": [
      {
        "type": "fixture.report",
        "cardinality": "exactly_one",
        "as": "report",
        "display_name": "Final task outcomes"
      }
    ]
  },
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.ts",
        "export": "plugin"
      }
    }
  ]
}
