{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.ts"
      }
    },
    {
      "source": {
        "kind": "file",
        "ref": "plugin.ts"
      },
      "root": "caller"
    }
  ],
  "nodeset_imports": [
    {
      "path": "body.jsonc"
    }
  ],
  "pipeline": {
    "entry_mode": "async",
    "inputs": [],
    "nodes": [
      {
        "id": "start",
        "type_used": "ownership.terminal",
        "display_name": "start",
        "description": "Ownership fixture start"
      },
      {
        "id": "manage",
        "type_used": "ownership.manager",
        "display_name": "manage",
        "description": "Ownership fixture manage",
        "task_targets": {
          "work": {
            "type_used": "ownership.body"
          }
        }
      },
      {
        "id": "end",
        "type_used": "ownership.terminal",
        "display_name": "end",
        "description": "Ownership fixture end"
      }
    ],
    "edges": [
      [
        "start",
        "manage"
      ],
      [
        "manage",
        "end"
      ]
    ],
    "outputs": []
  }
}
