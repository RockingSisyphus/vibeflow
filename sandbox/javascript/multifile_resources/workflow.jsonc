{
  "plugins": [
    {
      "source": {
        "kind": "file",
        "ref": "plugin.ts"
      }
    }
  ],
  "host_extensions": [
    {
      "id": "demo.host"
    }
  ],
  "rulesets": [
    "vibeflow.workflow"
  ],
  "pipeline": {
    "nodes": [
      {
        "id": "start",
        "type_used": "demo.start",
        "display_name": "Start",
        "description": "Starts the computation"
      },
      {
        "id": "model",
        "type_used": "demo.model",
        "display_name": "Model",
        "description": "Computes one functional model block"
      },
      {
        "id": "end",
        "type_used": "demo.start",
        "display_name": "End",
        "description": "Finishes the computation"
      }
    ],
    "edges": [
      [
        "start",
        "model"
      ],
      [
        "model",
        "end"
      ]
    ],
    "outputs": [
      {
        "type": "number",
        "display_name": "Result",
        "cardinality": "exactly_one"
      }
    ]
  }
}
